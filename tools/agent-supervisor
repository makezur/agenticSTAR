def tmux_exists(name: str) -> bool:
    return subprocess.run(
        ["tmux", "has-session", "-t", f"={name}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0


def attach(name: str) -> int:
    if os.environ.get("TMUX"):
        return subprocess.call(["tmux", "switch-client", "-t", f"={name}"])
    return subprocess.call(["tmux", "attach-session", "-t", f"={name}"])


def start(args: argparse.Namespace) -> int:
    run_dir = Path(args.run_dir).resolve()
    if not run_dir.is_dir():
        raise SystemExit(f"run directory not found: {run_dir}")
    if not (run_dir / "layout.json").is_file():
        raise SystemExit(f"not a reconstruction run (layout.json missing): {run_dir}")
    name = session_name(run_dir)
    script = str(Path(__file__).resolve())
    command = [
        script,
        "_supervise",
        "--run-dir",
        str(run_dir),
        "--launcher",
        str(Path(args.launcher).resolve()),
        "--tmux-session",
        name,
    ]
    if args.gpus:
        command.extend(["--gpus", args.gpus])
    if args.codex_provider:
        command.extend(["--codex-provider", args.codex_provider])
    if args.max_attempts is not None:
        if args.max_attempts < 1:
            raise SystemExit("--max-attempts must be >= 1")
        command.extend(["--max-attempts", str(args.max_attempts)])
    if args.max_rotations is not None:
        if args.max_rotations < 0:
            raise SystemExit("--max-rotations must be >= 0")
        command.extend(["--max-rotations", str(args.max_rotations)])
    if args.timeout_hours is not None:
        if (not math.isfinite(args.timeout_hours)
                or args.timeout_hours <= 0):
            raise SystemExit("--timeout-hours must be a positive finite number")
        command.extend(["--timeout-hours", str(args.timeout_hours)])
    if args.prompt:
        command.extend(["--prompt", args.prompt])
    if args.fresh:
        command.append("--fresh")
    shell_command = shlex.join(command)

    if tmux_exists(name):
        state = read_json(run_dir / "supervisor/state.json")
        if state.get("status") in {"running", "starting", "backoff", "stopping"}:
            print(f"supervisor already active in tmux session {name}")
            return 0 if args.detach else attach(name)
        if args.invocation != "resume":
            raise SystemExit(
                f"tmux session {name} is retained for inspection; use --resume-run"
            )
        window = f"resume-{int(state.get('attempt', 0)) + 1}"
        subprocess.run(
            [
                "tmux",
                "new-window",
                "-d",
                "-t",
                f"={name}",
                "-n",
                window,
                shell_command,
            ],
            check=True,
        )
        subprocess.run(
            [
                "tmux",
                "set-window-option",
                "-t",
                f"={name}:{window}",
                "remain-on-exit",
                "on",
            ],
            check=True,
        )
        subprocess.run(
            ["tmux", "select-window", "-t", f"={name}:{window}"], check=True
        )
    else:
        subprocess.run(
            [
                "tmux",
                "new-session",
                "-d",
                "-s",
                name,
                "-n",
                "supervisor",
                shell_command,
            ],
            check=True,
        )
        subprocess.run(
            [
                "tmux",
                "set-window-option",
                "-t",
                f"={name}:supervisor",
                "remain-on-exit",
                "on",
            ],
            check=True,
        )
    print(f"Supervisor tmux session: {name}")
    print(f"Logs: {run_dir / 'supervisor/combined.log'}")
    return 0 if args.detach else attach(name)


def status(args: argparse.Namespace) -> int:
    run_dir = Path(args.run_dir).resolve()
    state = read_json(run_dir / "supervisor/state.json")
    if not state:
        print(f"no supervisor state for {run_dir}")
        return 1
    print(json.dumps(state, indent=2, sort_keys=True))
    return 0


def stop(args: argparse.Namespace) -> int:
    run_dir = Path(args.run_dir).resolve()
    sup_dir = run_dir / "supervisor"
    sup_dir.mkdir(exist_ok=True)
    (sup_dir / "stop").touch()
    state = read_json(sup_dir / "state.json")
    name = state.get("tmux_session") or session_name(run_dir)
    if tmux_exists(name):
        subprocess.run(["tmux", "send-keys", "-t", f"={name}", "C-c"], check=False)
    print(f"stop requested for {name}")
    return 0


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    sub = result.add_subparsers(dest="action", required=True)
    for action in ("start", "resume"):
        item = sub.add_parser(action)
        item.add_argument("--run-dir", required=True)
        item.add_argument("--launcher", required=True)
        item.add_argument("--gpus", default="")
        item.add_argument(
            "--codex-provider", choices=("openai",), default=""
        )
        item.add_argument("--max-attempts", type=int)
        item.add_argument("--max-rotations", type=int)
        item.add_argument("--timeout-hours", type=float)
        item.add_argument("--prompt")
        item.add_argument("--detach", action="store_true")
        item.set_defaults(
            func=start, fresh=action == "start", invocation=action
        )
    for action, func in (("status", status), ("attach", None), ("stop", stop)):
        item = sub.add_parser(action)
        item.add_argument("--run-dir", required=True)
        if action == "attach":
            item.set_defaults(
                func=lambda args: attach(session_name(Path(args.run_dir).resolve()))
            )
        else:
            item.set_defaults(func=func)
    internal = sub.add_parser("_supervise", help=argparse.SUPPRESS)
    internal.add_argument("--run-dir", required=True)
    internal.add_argument("--launcher", required=True)
    internal.add_argument("--tmux-session", required=True)
    internal.add_argument("--gpus", default="")
    internal.add_argument(
        "--codex-provider", choices=("openai",), default=""
    )
    internal.add_argument("--max-attempts", type=int)
    internal.add_argument("--max-rotations", type=int)
    internal.add_argument("--timeout-hours", type=float)
    internal.add_argument("--prompt")
    internal.add_argument("--fresh", action="store_true")
    internal.set_defaults(func=lambda args: Supervisor(args).run())
    return result


def main() -> int:
    args = parser().parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
