BACKOFF = (5, 15, 30, 60, 120, 300)
# A rate limit is not a crash loop: it is shared account load, every run
# launched in the same batch shares it, and it clears on its own. Retrying it on
# the transient ladder is actively wrong -- that ladder opens at 5s, the client
# has *already* exhausted its own internal retries to surface the error at all
# ("exceeded retry limit, last status: 429"), and six failures spent that fast
# would tear down an hour-old run inside nine minutes. So wait long enough for
# the window to actually reopen. The rotation limit remains the failure budget.
RATE_LIMIT_BACKOFF = (60, 180, 300, 600, 900, 1800)
# A usage limit is the account's own time window, not thread damage: a fresh
# thread hits the same wall instantly, so rotating for one just burns the
# budget. Wait out the window and resume the exact thread instead. The ladder
# opens well above the rate-limit one because these windows reset on the hour.
USAGE_LIMIT_BACKOFF = (900, 1800, 3600)
MAX_ROTATIONS = 10
RECOVERABLE_FAILURES = frozenset(
    {"transient", "rate_limited", "usage_limited", "unclassified"}
)
# Throttling clears on its own, so a resume that re-hits it quickly is the
# expected shape of a shared window, not evidence the thread is damaged --
# these never trigger the failed-recovery rotation.
THROTTLE_FAILURES = frozenset({"rate_limited", "usage_limited"})
IMMEDIATE_ROTATION_FAILURES = frozenset({"request_too_large", "budget_limited"})
# Goal statuses the app-server may legitimately lift back to `active`: a block
# stamped by a dead turn, or a usage window that has since reopened. `paused`
# is a human's hold and `budget_limited` is the goal's own spent budget --
# neither is the supervisor's to override. The goal store spells statuses
# snake_case while the app-server protocol spells them camelCase
# (`usageLimited`); both forms are listed so each source can be checked as-is.
REACTIVATABLE_GOAL_STATUSES = frozenset({"blocked", "usage_limited", "usageLimited"})
# A goal Codex has stalled on. `blocked` is the agent's own impasse verdict;
# `paused`, `usage_limited`, and `budget_limited` are holds it will not lift on
# its own either. All of them leave the thread unable to make progress, and
# `create_goal` refuses to open a replacement while one is unfinished.
STALLED_GOAL_STATUSES = frozenset(
    {"blocked", "paused", "usage_limited", "budget_limited"}
)
# The CLI's positional prompt is ordinary user text, so ``"/goal resume"`` does
# not invoke the TUI command. A blocked goal caused by an outage is reactivated
# through app-server before the same thread is resumed. Context and usage limits,
# request_too_large, genuine impasses, and failed same-thread recovery rotate to
# a fresh thread instead.
IDLE_GOAL_SECONDS = 1800.0
# Codex marks the goal blocked the instant a turn dies, so a stalled status alone
# says nothing about whether the agent is still working. A resume that is
# actively recovering must not be torn down, so also require the rollout to go
# quiet -- and healthy silence runs long: a 10-minute render or sweep emits
# nothing at all. This is deliberately far above that, because the two cheap
# signals (the pre-launch store check and the agent's own surrender text)
# already catch every stall; this is only the backstop for a stall that
# announces itself neither way, and a late rotation costs one idle run while an
# early one kills a working agent mid-sweep.
# The transient counter controls backoff, but does not stop the run. A clean
# task_complete or a long-lived attempt resets it; fresh-thread rotations are
# the bounded recovery operation.
PROGRESS_SECONDS = 120.0
# Backstop for that reset: a run failing just past the progress threshold every
# time would otherwise retry forever.
MAX_TOTAL_ATTEMPTS = 40
ANSI_RE = re.compile(
    rb"(?:\x1b\][^\x07]*(?:\x07|\x1b\\)|\x1b[@-_][0-?]*[ -/]*[@-~])"
)
OVERSIZE_RE = re.compile(
    r"request_too_large|request exceeds the maximum allowed size", re.I
)
# ``(?:ed|[_ ]reached)`` covers the structured code (usage_limit_reached), the
# prose ("Usage limit reached"), and the adjective ("usage limited") -- but not
# a bare "usage limit", which agent prose uses innocently.
USAGE_LIMIT_RE = re.compile(
    r"usage[_ ]limit(?:ed|[_ ]reached)|usage quota (?:exhausted|reached)", re.I
)
BUDGET_LIMIT_RE = re.compile(
    r"budget[_ ]limit(?:ed|[_ ]reached)|token budget (?:exhausted|reached)", re.I
)
# Throttling. The canonical shape this arrives in is the client giving up:
# "exceeded retry limit, last status: 429 Too Many Requests". A bare 429 needs
# the same http/status/error context every other bare code needs, but the reason
# phrase and the error codes are unambiguous on their own. Kept ahead of
# TRANSIENT_RE by classify_text, because that message also carries the word
# "retry" and a burst of them is not a crash loop.
RATE_LIMIT_RE = re.compile(
    r"too many requests|rate[_ ]?limit(?:ed|_exceeded|s)?|"
    # A trailing decimal makes it a measurement, not a status: the agent reports
    # "median error 429.3mm" constantly, and \b alone accepts the dot.
    r"\b(?:http(?:\s+status)?|status|error)\s*[:=]?\s*429\b(?!\.\d)|"
    r"\bquota\s+exceeded\b",
    re.I,
)
# Bare status codes need an http/status/error context: agent output is full of
# frame counts and sample sizes ("1500 samples"), and the canonical reason
# phrases ("Bad Gateway", "Service Unavailable") are matched on their own.
# A bare "timeout" needs one too: the agent wraps its own shell commands in
# timeout(1) ("timeout --signal=INT --kill-after=10s 120s micromamba run ..."),
# so the word alone appears in perfectly healthy output.
#
# "Stream disconnected before completion" is the response stream dying mid-turn,
# and the TUI's own "Reconnecting... 1/5" ladder can exhaust without any of the
# suffixes matching: the observed tails are "idle timeout waiting for SSE", a
# prose "The server had an error while processing your request", and "Transport
# error: network error: error decoding response body". Only the fourth
# ("Transport error: timeout") hit a pattern, so the same outage classified
# three different ways. The prefix is unambiguous on its own -- nothing healthy
# reports a disconnected stream -- so match it without requiring the suffix.
# "Transport error" keeps its colon: bare, it would swallow the transport error
# of an optimal-transport loss, which is ordinary geometry vocabulary here.
TRANSIENT_RE = re.compile(
    r"internal[_ ]server[_ ]error|"
    r"\b(?:http(?:\s+status)?|status|error)\s*[:=]?\s*(?:500|502|503|504)\b(?!\.\d)|"
    r"\btimed\s+out\b|request_timeout|"
    r"\b(?:error|stream|request|connection|read|write)\s*[:=]?\s*time\s*out\b|"
    r"connection (?:reset|closed|aborted)|"
    r"stream disconnected|idle timeout waiting for sse|transport error\s*:|"
    r"connectionreseterror|service unavailable|bad gateway|gateway timeout",
    re.I,
)
# An agent that gives up ends its turn cleanly, so only its wording separates a
# surrender from a delivery. Match the inability *and* its object: a healthy
# final summary routinely says it could not complete some sub-step ("I couldn't
# complete the rz sweep, so I fixed the hinge and all gates pass"), and only an
# abandonment aims that inability at the whole run. The apostrophe may be either
# ASCII or the U+2019 the model actually emits.
GAVE_UP_RE = re.compile(
    r"\b(?:could\s*n[o']?t|couldn['’]t|can\s*not|cannot|can['’]t|"
    r"(?:was|were|am|are)\s+(?:not\s+able|unable)\s+to|"
    r"(?:was|were)n['’]?t\s+able\s+to|unable\s+to)\s+"
    r"(?:fully\s+|successfully\s+|actually\s+)?"
    r"(?:complete|finish|deliver|produce)\b[^.\n]{0,80}?"
    r"\b(?:reconstruction|run|goal|objective|task|assignment)\b",
    re.I,
)
# A failure the TUI attributes to a thread id belongs to a spawned subagent, not
# to the session being supervised. See strip_thread_errors.
THREAD_ERROR_RE = re.compile(
    r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
    r"\s*:[^\n]*\berror[^\n]*",
    re.I,
)


def atomic_json(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with tmp.open("w", encoding="utf-8") as handle:
        json.dump(value, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, path)


def read_json(path: Path) -> dict[str, Any]:
    try:
        with path.open(encoding="utf-8") as handle:
            value = json.load(handle)
        return value if isinstance(value, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}


def goal_status(store: Path, thread_id: str) -> tuple[str, float] | None:
    """Read ``(status, updated_at_seconds)`` for one thread's goal.

    Codex owns this SQLite store and writes it with WAL, so open it read-only
    and immutable=0: a supervisor must never take a write lock on the store the
    live agent depends on. Any error means "no verdict" -- the goal store is a
    supplementary signal, and a missing or busy database must never be read as
    a stalled goal.
    """
    if not store.is_file():
        return None
    try:
        connection = sqlite3.connect(
            f"file:{store}?mode=ro", uri=True, timeout=2.0
        )
        try:
            row = connection.execute(
                "SELECT status, updated_at_ms FROM thread_goals WHERE thread_id = ?",
                (thread_id,),
            ).fetchone()
        finally:
            connection.close()
    except sqlite3.Error:
        return None
    if not row or not isinstance(row[0], str):
        return None
    try:
        updated = float(row[1]) / 1000.0
    except (TypeError, ValueError):
        return None
    return row[0], updated


def session_name(run_dir: Path) -> str:
    clean = re.sub(r"[^A-Za-z0-9_-]+", "-", run_dir.name).strip("-") or "run"
    digest = hashlib.sha256(str(run_dir).encode()).hexdigest()[:8]
    return f"agent-{clean[:64]}-{digest}"


def sandbox_run_dir(run_dir: Path) -> str:
    return f"/home/ubuntu/articulated_script/runs/{run_dir.name}"


def classify_text(text: str) -> str | None:
    if OVERSIZE_RE.search(text):
        return "request_too_large"
    if USAGE_LIMIT_RE.search(text):
        return "usage_limited"
    if BUDGET_LIMIT_RE.search(text):
        return "budget_limited"
    # Before transient: the message that carries a 429 is itself a report of
    # exhausted retries, and its own words ("exceeded retry limit") would read as
    # a generic failure. Throttling needs the long ladder, not the 5s one.
    if RATE_LIMIT_RE.search(text):
        return "rate_limited"
    if TRANSIENT_RE.search(text):
        return "transient"
    return None


def structured_error_values(value: Any) -> list[Any]:
    """Extract structured error values, including JSON embedded in strings."""
    values: list[Any] = []
    if isinstance(value, dict):
        for key, item in value.items():
            if key.lower() in {"code", "status", "status_code", "type"}:
                values.append(item)
            values.extend(structured_error_values(item))
    elif isinstance(value, list):
        for item in value:
            values.extend(structured_error_values(item))
    elif isinstance(value, str):
        stripped = value.strip()
        if stripped.startswith(("{", "[")):
            try:
                values.extend(structured_error_values(json.loads(stripped)))
            except json.JSONDecodeError:
                pass
    return values


def classify_error(error: Any) -> str:
    """Prefer exact structured fields, then fall back to human-readable text."""
    values = {
        str(value).strip().lower().replace("-", "_")
        for value in structured_error_values(error)
    }
    if values & {"request_too_large", "context_length_exceeded"}:
        return "request_too_large"
    if values & {"usage_limited", "usage_limit_reached"}:
        return "usage_limited"
    if values & {"budget_limited", "budget_limit_reached"}:
        return "budget_limited"
    if values & {
        "429",
        "rate_limit_exceeded",
        "rate_limited",
    }:
        return "rate_limited"
    if values & {
        "500",
        "502",
        "503",
        "504",
        "internal_server_error",
        "request_timeout",
    }:
        return "transient"
    return classify_text(event_text(error)) or "unclassified"


def strip_thread_errors(text: str) -> str:
    """Drop failures the TUI attributes to a spawned subagent.

    A window refiner's outage surfaces on the orchestrator's own terminal as
    ``<thread-id>: Error - Internal server error`` while the orchestrator is
    already handling it -- closing that thread and respawning it against the
    same immutable brief. Reading it as the supervised session's failure tears
    down a healthy orchestrator and kills every other live window with it.

    Consume the whole line, so no fragment of it can be classified either.
    """
    return THREAD_ERROR_RE.sub(" <subagent failure> ", text)


def event_text(value: Any) -> str:
    if isinstance(value, str):
        return value
    if isinstance(value, dict):
        return " ".join(event_text(item) for item in value.values())
    if isinstance(value, list):
        return " ".join(event_text(item) for item in value)
    return ""


def classify_event(event: dict[str, Any]) -> tuple[str | None, bool]:
    """Return (failure class, successful task completion).

    A ``task_complete`` with no error is not automatically a win. An agent that
    abandons the reconstruction ends its turn cleanly and apologises -- "I'm
    sorry, but I couldn't complete the reconstruction within this run." -- which
    is a *stall*, not a completion: it leaves the goal unfinished and the run
    dir short of its gates. Treating it as success is what let a blocked run sit
    idle for an hour and 47 minutes with a live child and nothing to restart it.
    """
    payload = event.get("payload")
    if not isinstance(payload, dict) or payload.get("type") != "task_complete":
        return None, False
    error = payload.get("error")
    if error:
        return classify_error(error), False
    if GAVE_UP_RE.search(event_text(payload.get("last_agent_message"))):
        return "goal_stalled", False
    return None, True


def recovery_prompt(run_dir: Path) -> str:
    sandbox = sandbox_run_dir(run_dir)
    return (
        "Recover and continue the interrupted reconstruction in RUN_DIR="
        f"{sandbox}. First run `PYTHONPATH=harness python -m bookkeeping status "
        f"--run-dir {sandbox}`. Inspect its active iteration, NOTES.md, scene.py, "
        "the latest reports and rendered side-by-sides, window state, and "
        "incomplete spool ledgers before "
        "acting. Preserve valid existing work, determine the unfinished step, "
        "then continue the goal in AGENT_TASK.md through completion."
    )


def stall_prompt(run_dir: Path) -> str:
    """Prompt for the thread that replaces one which gave up.

    The previous thread declared an impasse, so this one must not inherit its
    conclusion: name the impasse as the thing to re-examine, and point at the
    evidence on disk rather than at the abandoned reasoning.
    """
    sandbox = sandbox_run_dir(run_dir)
    return (
        "Continue the reconstruction in RUN_DIR="
        f"{sandbox}. The previous thread reached an impasse and stopped without "
        "finishing; its goal is abandoned, and this is a fresh attempt at the "
        "same objective. First run `PYTHONPATH=harness python -m bookkeeping "
        f"status --run-dir {sandbox}`. Re-derive the state from its active "
        "iteration, NOTES.md, scene.py, the newest reports, rendered "
        "side-by-sides, window state, and incomplete spool ledgers, and treat "
        "the previous thread's "
        "conclusions as unproven. Identify what actually blocked it, keep the "
        "work that verifies, discard what does not, and take a different "
        "approach to the step it could not finish. Then carry the goal in "
        "AGENT_TASK.md through completion."
    )


class Supervisor:
    def __init__(self, args: argparse.Namespace):
        self.args = args
        self.run_dir = Path(args.run_dir).resolve()
        self.sup_dir = self.run_dir / "supervisor"
        self.state_path = self.sup_dir / "state.json"
        self.stop_path = self.sup_dir / "stop"
        self.combined_path = self.sup_dir / "combined.log"
        self.state = read_json(self.state_path)
        self.child_pid: int | None = None
        self.master_fd: int | None = None
        self.stop_requested = False
        self.detected: str | None = None
        self.rollout: Path | None = None
        self.rollout_offset = 0
        self.fallback_buffer = ""
        self.attempt_started = 0.0
        self.lock_handle: Any = None
        self.rollout_touched = 0.0
        self.goal_checked = 0.0
        self.rotation_limit_value: int | None = None

    def timeout_reached(self) -> bool:
        """Request a clean stop once this run's persisted deadline has passed."""
        deadline = self.state.get("deadline_at")
        if not isinstance(deadline, (int, float)) or not math.isfinite(deadline):
            return False
        if time.time() < deadline:
            return False
        if not self.stop_requested:
            self.stop_requested = True
            self.save(
                status="stopping",
                timeout_reached=True,
                timeout_reason="deadline",
            )
            self.note("run deadline reached; stopping")
        self.terminate_child()
        return True

    def record_transcript(self, path: Path) -> None:
        """List ``path`` in ``state.json`` so the collector can archive it.

        Rollouts live under Codex's own home, not the run dir, and a rotated run
        has one per attempt; an external collector can archive whatever is listed
        here beside the run so a truncated batch can be diagnosed from the results.
        """
        transcripts = self.state.get("transcripts")
        if not isinstance(transcripts, list):
            transcripts = []
        if str(path) not in transcripts:
            transcripts.append(str(path))
        self.state["transcripts"] = transcripts

    def save(self, **updates: Any) -> None:
        self.state.update(updates)
        self.state["updated_at"] = time.time()
        atomic_json(self.state_path, self.state)

    def note(self, message: str) -> None:
        line = f"\n[supervisor {time.strftime('%Y-%m-%d %H:%M:%S')}] {message}\n"
        with self.combined_path.open("a", encoding="utf-8") as handle:
            handle.write(line)
        try:
            os.write(sys.stdout.fileno(), line.encode())
        except OSError:
            pass

    def acquire_lock(self) -> None:
        self.sup_dir.mkdir(parents=True, exist_ok=True)
        self.lock_handle = (self.sup_dir / "lock").open("a+")
        try:
            fcntl.flock(self.lock_handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise SystemExit(f"supervisor already active for {self.run_dir}")
        self.stop_path.unlink(missing_ok=True)

    def session_root(self) -> Path:
        override = os.environ.get("AGENT_SUPERVISOR_SESSION_ROOT")
        if override:
            return Path(override)
        codex_home = os.environ.get("HOST_CODEX_HOME")
        config_home = Path(
            os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))
        )
        config = config_home / "codex-articulated/paths.conf"
        if not codex_home and config.is_file():
            try:
                for line in config.read_text(encoding="utf-8").splitlines():
                    if line.startswith("HOST_CODEX_HOME="):
                        values = shlex.split(line.split("=", 1)[1], comments=True)
                        if len(values) == 1:
                            codex_home = os.path.expandvars(
                                os.path.expanduser(values[0])
                            )
                        break
            except (OSError, ValueError):
                pass
        if not codex_home:
            state_home = Path(
                os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))
            )
            codex_home = str(state_home / "codex-articulated/codex-home")
        return Path(codex_home) / "sessions"

    def goal_stores(self) -> list[Path]:
        """Codex goal databases, newest schema first.

        The store is versioned in its filename (``goals_1.sqlite``), so glob
        rather than pin: a Codex upgrade that bumps the number must not silently
        turn stall detection off.
        """
        override = os.environ.get("AGENT_SUPERVISOR_GOAL_STORE")
        if override:
            return [Path(override)]
        home = self.session_root().parent
        return sorted(home.glob("goals_*.sqlite"), reverse=True)

    def check_goal_stall(self) -> None:
        """Backstop for a stall that announces itself no other way.

        ``stalled_before_resume`` catches a goal already blocked at launch, and
        ``classify_event`` catches the agent's own surrender text. This covers
        what neither sees: a goal that goes stalled mid-attempt and simply stops
        -- one the agent keeps re-reading with ``get_goal`` while it burns the
        attempt down, never ending its turn to say so.
        """
        if self.detected or not self.rollout:
            return
        session = self.state.get("session_id")
        if not session:
            return
        now = time.monotonic()
        if now - self.goal_checked < 5.0:
            return
        self.goal_checked = now
        for store in self.goal_stores():
            found = goal_status(store, str(session))
            if not found:
                continue
            status, _updated = found
            if status not in STALLED_GOAL_STATUSES:
                return
            # Idleness is measured on the rollout, not on the goal row: Codex
            # stamps the row once when the turn dies and never touches it again,
            # so its own age keeps growing even while a resumed agent works.
            quiet = now - (self.rollout_touched or self.attempt_started)
            if quiet >= idle_goal_seconds():
                self.note(
                    f"goal is {status} and the thread has been idle "
                    f"{quiet:.0f}s; a stalled goal cannot be resumed in place"
                )
                self.detected = "goal_stalled"
            return

    def discover_rollout(
        self, baseline: dict[str, tuple[int, int]], expected_session: str | None
    ) -> tuple[Path, str] | None:
        sandbox_run = sandbox_run_dir(self.run_dir)
        matches: list[tuple[Path, str]] = []
        for path in self.session_root().glob("**/rollout-*.jsonl"):
            try:
                prior = baseline.get(str(path))
                if prior and prior[0] == path.stat().st_mtime_ns:
                    continue
                with path.open(encoding="utf-8", errors="replace") as handle:
                    first = handle.readline()
                    meta = json.loads(first)
                    payload = meta.get("payload", {})
                    sid = payload.get("session_id")
                    source = payload.get("source")
                    if not sid or (
                        isinstance(source, dict) and "subagent" in source
                    ):
                        continue
                    if expected_session:
                        if sid == expected_session:
                            matches.append((path, sid))
                    else:
                        sample = first + handle.read(2 * 1024 * 1024)
                        if sandbox_run in sample:
                            matches.append((path, sid))
            except (OSError, json.JSONDecodeError):
                continue
        unique = {str(path): (path, sid) for path, sid in matches}
        if len(unique) == 1:
            return next(iter(unique.values()))
        if len(unique) > 1:
            names = ", ".join(sorted(unique))
            raise RuntimeError(f"ambiguous Codex rollout discovery: {names}")
        return None

    def rollout_start(self, path: Path, baseline: dict[str, tuple[int, int]]) -> int:
        """Byte offset of this attempt's first event in ``path``.

        ``codex resume`` reopens the *same* rollout and appends, so a resumed
        thread's file already holds the outage that caused the resume. Tailing
        from byte 0 re-detects it, kills a healthy agent, and resumes again --
        the same stale event forever, one restart per backoff, until the
        total-attempt backstop trips. Skip whatever was already on disk when
        this attempt launched; only events appended since then are ours.
        """
        prior = baseline.get(str(path))
        if not prior:
            return 0
        try:
            return min(prior[1], path.stat().st_size)
        except OSError:
            return prior[1]

    def resize_child(self, *_: Any) -> None:
        if self.master_fd is None:
            return
        try:
            size = fcntl.ioctl(sys.stdin.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
            fcntl.ioctl(self.master_fd, termios.TIOCSWINSZ, size)
            if self.child_pid:
                os.killpg(self.child_pid, signal.SIGWINCH)
        except OSError:
            pass

    def terminate_child(self) -> None:
        if not self.child_pid:
            return
        try:
            os.killpg(self.child_pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            try:
                pid, _ = os.waitpid(self.child_pid, os.WNOHANG)
                if pid:
                    self.child_pid = None
                    return
            except ChildProcessError:
                self.child_pid = None
                return
            time.sleep(0.1)
        try:
            os.killpg(self.child_pid, signal.SIGKILL)
        except ProcessLookupError:
            pass

    def handle_signal(self, signum: int, _frame: Any) -> None:
        self.stop_requested = True
        self.save(status="stopping", stop_signal=signum)
        self.terminate_child()

    def tail_rollout(self) -> None:
        if not self.rollout:
            return
        try:
            with self.rollout.open(encoding="utf-8", errors="replace") as handle:
                handle.seek(self.rollout_offset)
                while True:
                    line_start = handle.tell()
                    line = handle.readline()
                    if not line:
                        break
                    if not line.endswith("\n"):
                        handle.seek(line_start)
                        break
                    try:
                        event = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    failure, success = classify_event(event)
                    if success:
                        # A clean completion supersedes any earlier fallback
                        # text match: don't let a stale detection terminate and
                        # resume a session that just finished successfully.
                        self.detected = None
                        self.fallback_buffer = ""
                        self.state["consecutive_transient_failures"] = 0
                        self.state.pop("resume_recovery_session_id", None)
                        self.state.pop("force_rotation_reason", None)
                        # A completed turn proves the window reopened, so earlier
                        # throttling is spent history, not a budget this run is
                        # still burning down.
                        self.state["rate_limits"] = 0
                        self.state["usage_limits"] = 0
                        self.save()
                    if failure:
                        self.detected = failure
                    # Any event at all is proof of life for the idle test in
                    # check_goal_stall.
                    self.rollout_touched = time.monotonic()
                self.rollout_offset = handle.tell()
        except OSError:
            pass

    def process_output(self, data: bytes, raw: Any, combined: Any) -> None:
        raw.write(data)
        raw.flush()
        clean = ANSI_RE.sub(b"", data).replace(b"\r", b"")
        combined.write(clean.decode("utf-8", errors="replace"))
        combined.flush()
        self.fallback_buffer = (
            self.fallback_buffer + clean.decode("utf-8", errors="replace")
        )[-8192:]
        # Terminal text is only a fallback: once the rollout is discovered the
        # structured task_complete events are authoritative, and agent output
        # (logs, tracebacks it reads, tool results) would otherwise trip the
        # patterns on healthy runs.
        if self.rollout is None:
            fallback = classify_text(strip_thread_errors(self.fallback_buffer))
            if fallback:
                self.detected = fallback
        try:
            os.write(sys.stdout.fileno(), data)
        except OSError:
            pass

    def spawn(self, command: list[str], attempt: int) -> int:
        baseline: dict[str, tuple[int, int]] = {}
        for path in self.session_root().glob("**/rollout-*.jsonl"):
            try:
                stat = path.stat()
                baseline[str(path)] = (stat.st_mtime_ns, stat.st_size)
            except OSError:
                pass
        launched_at = time.time()
        raw_path = self.sup_dir / f"attempt-{attempt}.raw.log"
        self.detected = None
        self.rollout = None
        self.rollout_offset = 0
        self.fallback_buffer = ""
        self.attempt_started = time.monotonic()
        self.rollout_touched = 0.0
        self.goal_checked = 0.0
        pid, master = pty.fork()
        if pid == 0:
            os.execvpe(command[0], command, os.environ.copy())
        self.child_pid, self.master_fd = pid, master
        self.resize_child()
        self.save(
            status="running",
            attempt=attempt,
            child_pid=pid,
            command=command,
            launched_at=launched_at,
            raw_log=str(raw_path),
        )

        expected = self.state.get("expected_session_id")
        selector = selectors.DefaultSelector()
        selector.register(master, selectors.EVENT_READ)
        if sys.stdin.isatty():
            selector.register(sys.stdin, selectors.EVENT_READ)
        discovered = False
        discovery_error: Exception | None = None
        discovery_deadline = time.monotonic() + float(
            os.environ.get("AGENT_SUPERVISOR_DISCOVERY_TIMEOUT", "45")
        )
        with raw_path.open("ab", buffering=0) as raw, self.combined_path.open(
            "a", encoding="utf-8"
        ) as combined:
            while True:
                self.timeout_reached()
                if self.stop_path.exists():
                    self.stop_requested = True
                    self.terminate_child()
                if not discovered and time.time() - launched_at > 0.25:
                    try:
                        found = self.discover_rollout(baseline, expected)
                        if found:
                            path, sid = found
                            self.rollout = path
                            self.rollout_offset = self.rollout_start(path, baseline)
                            self.record_transcript(path)
                            self.save(session_id=sid, rollout_path=str(path))
                            discovered = True
                        elif time.monotonic() >= discovery_deadline:
                            raise RuntimeError(
                                "could not discover the Codex rollout for this attempt"
                            )
                    except RuntimeError as exc:
                        discovery_error = exc
                        self.detected = "discovery_failed"
                        self.terminate_child()
                self.tail_rollout()
                self.check_goal_stall()
                if self.detected:
                    self.terminate_child()
                for key, _ in selector.select(0.2):
                    if key.fileobj == master:
                        try:
                            data = os.read(master, 65536)
                        except OSError as exc:
                            if exc.errno == errno.EIO:
                                data = b""
                            else:
                                raise
                        if data:
                            self.process_output(data, raw, combined)
                    else:
                        try:
                            data = os.read(sys.stdin.fileno(), 65536)
                            if data:
                                os.write(master, data)
                        except OSError:
                            pass
                try:
                    waited, status = os.waitpid(pid, os.WNOHANG)
                except ChildProcessError:
                    waited, status = pid, 0
                if waited:
                    self.child_pid = None
                    self.tail_rollout()
                    if discovery_error:
                        self.note(str(discovery_error))
                    return os.waitstatus_to_exitcode(status)

    def stalled_before_resume(self, session_id: str) -> str | None:
        """Goal status blocking a resume of ``session_id``, if any.

        Codex stamps the goal row the instant a turn dies, so by the time the
        supervisor decides to resume, the verdict is already on disk. Checking it
        *before* launching is what turns a wasted attempt into a rotation: in the
        run that motivated this, the goal went blocked five seconds before the
        resume launched, and the resumed thread then spent 108 minutes unable to
        open a goal before apologising.
        """
        for store in self.goal_stores():
            found = goal_status(store, session_id)
            if not found:
                continue
            status, _updated = found
            return status if status in STALLED_GOAL_STATUSES else None
        return None

    def app_server_response(
        self,
        process: subprocess.Popen[str],
        request_id: int,
        timeout: float,
        buffer: bytearray,
    ) -> dict[str, Any]:
        """Read one JSON-RPC response, ignoring notifications.

        Reads the pipe fd raw rather than through ``process.stdout``: the
        buffered stream's readline() can slurp a notification *and* the
        response in one os.read, leaving the response in Python's buffer where
        select() cannot see it -- a spurious timeout with the answer already
        in hand. ``buffer`` persists across requests on one connection, so a
        partial line left by one response carries into the next.
        """
        assert process.stdout is not None
        fd = process.stdout.fileno()
        deadline = time.monotonic() + timeout
        with selectors.DefaultSelector() as selector:
            selector.register(fd, selectors.EVENT_READ)
            while True:
                while b"\n" in buffer:
                    line, _, rest = bytes(buffer).partition(b"\n")
                    buffer[:] = rest
                    try:
                        message = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if message.get("id") == request_id:
                        return message
                remaining = deadline - time.monotonic()
                if remaining <= 0 or not selector.select(remaining):
                    break
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                buffer += chunk
        raise RuntimeError(f"app-server request {request_id} timed out")

    def reactivate_goal(self, session_id: str) -> bool:
        """Reactivate a blocked goal through Codex's supported app-server API."""
        command = self.launcher_command() + ["app-server", "--stdio"]
        try:
            timeout = float(
                os.environ.get("AGENT_SUPERVISOR_APP_SERVER_TIMEOUT", "20")
            )
        except ValueError:
            timeout = 20.0
        process: subprocess.Popen[str] | None = None
        buffer = bytearray()
        try:
            process = subprocess.Popen(
                command,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                bufsize=1,
            )
            assert process.stdin is not None

            def send(request: dict[str, Any]) -> None:
                process.stdin.write(json.dumps(request) + "\n")
                process.stdin.flush()

            send(
                {
                    "method": "initialize",
                    "id": 1,
                    "params": {
                        "clientInfo": {
                            "name": "agent-supervisor",
                            "title": "Agent Supervisor",
                            "version": "1",
                        }
                    },
                }
            )
            initialized = self.app_server_response(process, 1, timeout, buffer)
            if initialized.get("error"):
                raise RuntimeError(str(initialized["error"]))
            send({"method": "initialized", "params": {}})
            send(
                {
                    "method": "thread/resume",
                    "id": 2,
                    "params": {"threadId": session_id},
                }
            )
            resumed = self.app_server_response(process, 2, timeout, buffer)
            if resumed.get("error"):
                raise RuntimeError(str(resumed["error"]))
            send(
                {
                    "method": "thread/goal/get",
                    "id": 3,
                    "params": {"threadId": session_id},
                }
            )
            current = self.app_server_response(process, 3, timeout, buffer)
            goal = current.get("result", {}).get("goal")
            if not isinstance(goal, dict):
                raise RuntimeError("app-server returned no goal")
            status = goal.get("status")
            if status not in REACTIVATABLE_GOAL_STATUSES:
                raise RuntimeError(f"goal changed to {status!r} before reactivation")
            send(
                {
                    "method": "thread/goal/set",
                    "id": 4,
                    "params": {"threadId": session_id, "status": "active"},
                }
            )
            updated = self.app_server_response(process, 4, timeout, buffer)
            updated_goal = updated.get("result", {}).get("goal")
            if updated.get("error") or not isinstance(updated_goal, dict):
                raise RuntimeError(str(updated.get("error") or "missing updated goal"))
            if updated_goal.get("status") != "active":
                raise RuntimeError(
                    f"goal reactivation returned {updated_goal.get('status')!r}"
                )
            self.note(f"reactivated blocked goal for {session_id} through app-server")
            return True
        except (OSError, RuntimeError, ValueError) as exc:
            self.note(f"could not reactivate goal for {session_id}: {exc}")
            return False
        finally:
            if process is not None and process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()

    def rotate_thread(self, reason: str) -> int | None:
        """Abandon the current thread. Only this operation spends rotations."""
        rotations = int(self.state.get("rotations", 0)) + 1
        if rotations > self.rotation_limit():
            return None
        self.state["rotations"] = rotations
        if reason == "goal_stalled":
            self.state["goal_stalls"] = int(self.state.get("goal_stalls", 0)) + 1
            self.state["use_stall_prompt"] = True
        else:
            self.state["use_recovery_prompt"] = True
            self.state.pop("use_stall_prompt", None)
        self.state["consecutive_transient_failures"] = 0
        self.state.pop("session_id", None)
        self.state.pop("rollout_path", None)
        self.state.pop("expected_session_id", None)
        self.state.pop("resume_recovery_session_id", None)
        self.state.pop("force_rotation_reason", None)
        return rotations

    def rotation_limit(self) -> int:
        if self.rotation_limit_value is not None:
            return self.rotation_limit_value
        configured = self.args.max_rotations
        if configured is None:
            stored = self.state.get("max_rotations")
            if isinstance(stored, int) and stored >= 0:
                configured = stored
        if configured is None:
            configured = max_rotations()
        if configured < 0:
            raise SystemExit("--max-rotations must be >= 0")
        self.rotation_limit_value = configured
        return configured

    def launcher_command(self) -> list[str]:
        provider = str(self.state.get("codex_provider") or "openai")
        return [
            self.args.launcher,
            "--run-dir",
            str(self.run_dir),
            "--codex-provider",
            provider,
        ]

    def command(self, fresh: bool) -> list[str] | None:
        command = self.launcher_command()
        session_id = self.state.get("session_id")
        force_rotation = self.state.get("force_rotation_reason")
        if not fresh and session_id and force_rotation:
            rotations = self.rotate_thread(str(force_rotation))
            if rotations is None:
                return None
            self.note(
                f"same-thread recovery did not hold; rotating to a fresh thread "
                f"({rotations}/{self.rotation_limit()})"
            )
            fresh = True
            session_id = None
        if not fresh and session_id:
            stalled = self.stalled_before_resume(str(session_id))
            if stalled:
                failure = self.state.get("failure")
                reactivatable = stalled in REACTIVATABLE_GOAL_STATUSES
                if (
                    reactivatable
                    and failure in RECOVERABLE_FAILURES
                    and self.reactivate_goal(str(session_id))
                ):
                    self.state["resume_recovery_session_id"] = session_id
                else:
                    reason = str(
                        (failure or stalled) if reactivatable else stalled
                    )
                    rotations = self.rotate_thread(reason)
                    if rotations is None:
                        return None
                    self.note(
                        f"goal for {session_id} is {stalled}; rotating to a fresh "
                        f"thread ({rotations}/{self.rotation_limit()})"
                    )
                    fresh = True
                    session_id = None
        if not fresh and session_id:
            command.extend(
                [
                    "resume",
                    session_id,
                    "Continue the active goal from where it was interrupted.",
                ]
            )
            self.state["expected_session_id"] = session_id
            if self.state.get("failure") in RECOVERABLE_FAILURES:
                self.state["resume_recovery_session_id"] = session_id
        else:
            if self.state.pop("use_stall_prompt", False):
                prompt = stall_prompt(self.run_dir)
            elif self.state.get("use_recovery_prompt"):
                prompt = recovery_prompt(self.run_dir)
            else:
                prompt = self.state.get("original_prompt") or recovery_prompt(self.run_dir)
            command.append(f"/goal {prompt}")
            self.state.pop("expected_session_id", None)
        return command

    def run(self) -> int:
        self.acquire_lock()
        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, self.handle_signal)
        signal.signal(signal.SIGWINCH, self.resize_child)
        if sys.stdin.isatty():
            original_termios = termios.tcgetattr(sys.stdin.fileno())
            tty.setraw(sys.stdin.fileno())
            atexit.register(
                termios.tcsetattr,
                sys.stdin.fileno(),
                termios.TCSADRAIN,
                original_termios,
            )

        configured_gpus = self.args.gpus or str(self.state.get("gpus", ""))
        if not configured_gpus:
            config = read_json(self.run_dir / "run_config.json")
            pool = config.get("pool", {})
            gpu_values = pool.get("gpus", []) if isinstance(pool, dict) else []
            if isinstance(gpu_values, list):
                configured_gpus = ",".join(str(value) for value in gpu_values)
        if configured_gpus:
            os.environ["SANDBOX_GPUS"] = configured_gpus
        configured_provider = (
            self.args.codex_provider
            or str(self.state.get("codex_provider", ""))
            or "openai"
        )
        if configured_provider not in {"openai"}:
            raise SystemExit(
                f"--codex-provider must be openai, got "
                f"{configured_provider!r}"
            )
        configured_max_attempts = self.args.max_attempts
        if configured_max_attempts is None:
            stored_max_attempts = self.state.get("max_attempts")
            if isinstance(stored_max_attempts, int) and stored_max_attempts >= 1:
                configured_max_attempts = stored_max_attempts
        if configured_max_attempts is None:
            configured_max_attempts = max_total_attempts()
        if configured_max_attempts < 1:
            raise SystemExit("--max-attempts must be >= 1")
        configured_timeout_hours = self.args.timeout_hours
        if configured_timeout_hours is not None:
            if (not math.isfinite(configured_timeout_hours)
                    or configured_timeout_hours <= 0):
                raise SystemExit("--timeout-hours must be a positive finite number")
            deadline_at = time.time() + configured_timeout_hours * 3600.0
            self.state.pop("timeout_reached", None)
            self.state.pop("timeout_reason", None)
        else:
            stored_timeout = self.state.get("timeout_hours")
            stored_deadline = self.state.get("deadline_at")
            if (isinstance(stored_timeout, (int, float))
                    and math.isfinite(stored_timeout)
                    and stored_timeout > 0
                    and isinstance(stored_deadline, (int, float))
                    and math.isfinite(stored_deadline)):
                configured_timeout_hours = float(stored_timeout)
                deadline_at = float(stored_deadline)
            else:
                configured_timeout_hours = None
                deadline_at = None
        configured_max_rotations = self.rotation_limit()
        prior_attempts = int(self.state.get("attempt", 0))
        self.state.update(
            run_dir=str(self.run_dir),
            tmux_session=self.args.tmux_session,
            launcher=self.args.launcher,
            codex_provider=configured_provider,
            gpus=configured_gpus,
            max_attempts=configured_max_attempts,
            max_rotations=configured_max_rotations,
            timeout_hours=configured_timeout_hours,
            deadline_at=deadline_at,
            original_prompt=self.args.prompt or self.state.get("original_prompt"),
            consecutive_transient_failures=0,
            rotations=int(self.state.get("rotations", 0)),
            supervisor_pid=os.getpid(),
            started_at=time.time(),
        )
        if self.args.fresh:
            self.state["use_recovery_prompt"] = False
            self.state["goal_stalls"] = 0
            self.state["rotations"] = 0
            self.state.pop("use_stall_prompt", None)
            self.state.pop("session_id", None)
            self.state.pop("rollout_path", None)
            self.state.pop("expected_session_id", None)
            self.state.pop("resume_recovery_session_id", None)
            self.state.pop("force_rotation_reason", None)
        fresh = self.args.fresh or not self.state.get("session_id")
        self.save(status="starting")

        while not self.stop_requested:
            self.timeout_reached()
            if self.stop_requested:
                break
            attempt = prior_attempts + 1
            prior_attempts = attempt
            command = self.command(fresh)
            fresh = False
            if command is None:
                failure = str(
                    self.state.get("force_rotation_reason")
                    or self.state.get("failure")
                    or "rotation_limit"
                )
                self.save(status="failed", failure=failure)
                self.note(
                    f"stopping after {configured_max_rotations} thread rotations: the run "
                    "needs a human"
                )
                return 1
            self.note(f"starting attempt {attempt}: {shlex.join(command[:-1])}")
            exit_code = self.spawn(command, attempt)
            failure = self.detected
            elapsed = time.monotonic() - self.attempt_started
            if self.stop_requested:
                exit_code = 124 if self.state.get("timeout_reached") else exit_code
                self.save(status="stopped", exit_code=exit_code)
                return exit_code if exit_code == 124 else 130
            if not failure:
                if exit_code not in (0, 129, 130, 143):
                    failure = "transient"
                    self.note(f"agent process died with status {exit_code}")
                else:
                    self.save(status="exited", exit_code=exit_code, child_pid=None)
                    self.note(f"agent exited with status {exit_code}; not restarting")
                    return exit_code
            recovery_session = self.state.get("resume_recovery_session_id")
            if recovery_session and elapsed >= progress_seconds():
                self.note(
                    f"same-thread recovery for {recovery_session} made "
                    f"{elapsed:.0f}s of progress"
                )
                self.state.pop("resume_recovery_session_id", None)
                recovery_session = None
            elif (
                recovery_session
                and failure in RECOVERABLE_FAILURES
                and failure not in THROTTLE_FAILURES
            ):
                # A resume that promptly re-hits throttling is the expected
                # shape of a shared window still closed -- the thread is fine,
                # so it never spends a rotation. Anything else re-dying this
                # fast means the same-thread recovery did not hold.
                self.state["force_rotation_reason"] = failure
            if failure == "discovery_failed":
                self.save(status="failed", failure=failure, exit_code=exit_code)
                self.note(f"stopping after non-recoverable failure: {failure}")
                return 1
            if failure == "unclassified":
                # The classifier will always trail the API's vocabulary, so the
                # default has to be to retry.
                # Resuming is cheap, and a failed resume falls through to the
                # bounded rotation path. It stays *named* unclassified in the
                # state file, so these are still findable and can be given a
                # pattern.
                self.note(
                    "unrecognised failure text; retrying on the transient ladder"
                )
            if failure in IMMEDIATE_ROTATION_FAILURES:
                rotations = self.rotate_thread(failure)
                if rotations is None:
                    self.save(status="failed", failure=failure)
                    self.note(
                        f"stopping after {configured_max_rotations} thread rotations: "
                        "the run needs a human"
                    )
                    return 1
                fresh = True
                self.note(
                    f"{failure.replace('_', ' ')}; rotating to a fresh thread "
                    f"({rotations}/{configured_max_rotations})"
                )
                continue
            if failure == "goal_stalled":
                rotations = self.rotate_thread(failure)
                if rotations is None:
                    self.save(status="failed", failure=failure)
                    self.note(
                        f"stopping after {configured_max_rotations} thread rotations: "
                        "the run needs a human"
                    )
                    return 1
                fresh = True
                self.save(status="backoff", failure=failure)
                self.note(
                    f"goal stalled; rotating to a fresh thread with a new goal "
                    f"({rotations}/{configured_max_rotations})"
                )
                continue

            if attempt >= configured_max_attempts:
                self.save(status="failed", failure=failure)
                self.note(f"stopping after {attempt} total attempts for this run")
                return 1
            if failure in THROTTLE_FAILURES:
                # Resume the exact thread: throttling costs nothing of the
                # thread's context, so there is nothing to rotate away from.
                # A usage limit gets its own, longer ladder -- it is the
                # account's time window, and a fresh thread hits it just the
                # same, so waiting it out is the only move that helps.
                counter = f"{failure.removesuffix('ed')}s"
                limits = int(self.state.get(counter, 0)) + 1
                self.state[counter] = limits
                ladder = (
                    usage_limit_backoff()
                    if failure == "usage_limited"
                    else rate_limit_backoff()
                )
                delay = ladder[min(limits, len(ladder)) - 1]
                self.save(status="backoff", failure=failure, retry_in=delay)
                self.note(
                    f"{failure.replace('_', ' ')} ({limits}); resuming exact "
                    f"thread in {delay}s"
                )
                deadline = time.monotonic() + delay
                while time.monotonic() < deadline and not self.stop_requested:
                    self.timeout_reached()
                    if self.stop_path.exists():
                        self.stop_requested = True
                        break
                    time.sleep(min(0.25, deadline - time.monotonic()))
                continue
            prior = int(self.state.get("consecutive_transient_failures", 0))
            if prior and elapsed >= progress_seconds():
                self.note(
                    f"attempt {attempt} ran {elapsed:.0f}s before failing; "
                    f"clearing {prior} earlier consecutive failure(s)"
                )
                prior = 0
            failures = prior + 1
            self.state["consecutive_transient_failures"] = failures
            delay = backoff()[min(failures, len(backoff())) - 1]
            self.save(status="backoff", failure=failure, retry_in=delay)
            if self.state.get("force_rotation_reason"):
                self.note(
                    f"transient failure; same-thread recovery did not hold, "
                    f"rotating to a fresh thread in {delay}s"
                )
            else:
                self.note(f"transient failure; resuming exact thread in {delay}s")
            deadline = time.monotonic() + delay
            while time.monotonic() < deadline and not self.stop_requested:
                self.timeout_reached()
                if self.stop_path.exists():
                    self.stop_requested = True
                    break
                time.sleep(min(0.25, deadline - time.monotonic()))
        exit_code = 124 if self.state.get("timeout_reached") else 130
        self.save(status="stopped", exit_code=exit_code)
        return exit_code


