BACKOFF = (5, 15, 30, 60, 120, 300)
# A rate limit is not a crash loop: it is shared account load, every run
# launched in the same batch shares it, and it clears on its own. Retrying it on
# the transient ladder is actively wrong -- that ladder opens at 5s, the client
# has *already* exhausted its own internal retries to surface the error at all
# ("exceeded retry limit, last status: 429"), and six failures spent that fast
# would tear down an hour-old run inside nine minutes. So wait long enough for
# the window to actually reopen. The rotation limit remains the failure budget.
RATE_LIMIT_BACKOFF = (60, 180, 300, 600, 900, 1800)
# A usage limit is the account's own time window, not thread damage: a fresh
# thread hits the same wall instantly, so rotating for one just burns the
# budget. Wait out the window and resume the exact thread instead. The ladder
# opens well above the rate-limit one because these windows reset on the hour.
USAGE_LIMIT_BACKOFF = (900, 1800, 3600)
MAX_ROTATIONS = 10
RECOVERABLE_FAILURES = frozenset(
    {"transient", "rate_limited", "usage_limited", "unclassified", "awaiting_input"}
)
# Throttling clears on its own, so a resume that re-hits it quickly is the
# expected shape of a shared window, not evidence the thread is damaged --
# these never trigger the failed-recovery rotation.
THROTTLE_FAILURES = frozenset({"rate_limited", "usage_limited"})
# Failures that never mean the session is damaged, so a resume that promptly
# re-hits one is not "same-thread recovery did not hold": throttling is the
# account's shared window, and a question is the agent pausing for input.
SAME_SESSION_FAILURES = THROTTLE_FAILURES | frozenset({"awaiting_input"})
IMMEDIATE_ROTATION_FAILURES = frozenset({"request_too_large", "budget_limited"})
# Failures no retry can fix: the run needs a human.
FATAL_FAILURES = frozenset({"discovery_failed", "auth_failed"})
# Claude Code's TUI does not exit when a turn ends; it waits for the next prompt.
# Once the transcript shows a clean end_turn, wait this long for anything else to
# happen (a human attached and typing, a straggling event), then stop the agent so
# the detached run reaches a terminal status instead of idling until the deadline.
# 0 disables the auto-stop. A live background batch is NOT this question: see
# SUBAGENT_QUIET_SECONDS.
COMPLETE_GRACE_SECONDS = 20.0
# Where a session's background agents write. Sibling of ``<id>.jsonl``, so an
# orchestrator waiting on a batch leaves the tailed transcript untouched while
# these files grow -- the run deadline, not this grace, bounds such a wait.
SUBAGENT_DIR_NAME = "subagents"
# What the Agent tool returns the moment a background agent is spawned. It is a
# ``tool_result`` under the launching ``tool_use`` id, so a supervisor that took
# any ``tool_result`` for "the agent reported back" would count the whole batch
# as merged before the orchestrator's turn even ended. The real report-back is a
# ``<task-notification>`` carrying the same id (TASK_NOTIFICATION_RE), whether
# it lands as a user message or only as a ``queue-operation`` enqueue.
LAUNCH_ACK_PREFIX = "Async agent launched"
TASK_NOTIFICATION_RE = re.compile(r"<tool-use-id>\s*([^<\s]+)\s*</tool-use-id>")
# Backstop for a batch that never reports back at all. Deliberately NOT
# COMPLETE_GRACE_SECONDS: that window asks "is anything about to follow this
# turn", which 20s answers, while this one asks "is a batch that owes me a
# tool_result ever going to send one" -- and a refiner spends whole minutes inside
# a single sweep or render without writing a transcript line.
#
# An hour, where Codex uses half of one, because the two supervisors lean on this
# number differently. For Codex, silence IS the test (paired only with a stalled
# goal status), so its bound has to stay near the longest silence a live batch
# produces. Here the exact outstanding count decides, and this fires only when an
# agent dies without ever reporting -- so the errors are lopsided: too tight cuts
# a live batch off through the back door, while too loose costs one wedged GPU
# until the run deadline, on a run already lost. Buy the safe direction.
SUBAGENT_QUIET_SECONDS = 3600.0
# The transient counter controls backoff, but does not stop the run. A clean
# task_complete or a long-lived attempt resets it; fresh-thread rotations are
# the bounded recovery operation.
PROGRESS_SECONDS = 120.0
# Backstop for that reset: a run failing just past the progress threshold every
# time would otherwise retry forever.
MAX_TOTAL_ATTEMPTS = 40
ANSI_RE = re.compile(
    rb"(?:\x1b\][^\x07]*(?:\x07|\x1b\\)|\x1b[@-_][0-?]*[ -/]*[@-~])"
)
OVERSIZE_RE = re.compile(
    r"request_too_large|request exceeds the maximum allowed size|"
    r"prompt is too long|prompt_too_long|context_length_exceeded", re.I
)
# ``(?:ed|[_ ]reached)`` covers the structured code (usage_limit_reached), the
# prose ("Usage limit reached"), and the adjective ("usage limited") -- but not
# a bare "usage limit", which agent prose uses innocently.
USAGE_LIMIT_RE = re.compile(
    r"usage[_ ]limit(?:ed|[_ ]reached)|usage quota (?:exhausted|reached)", re.I
)
BUDGET_LIMIT_RE = re.compile(
    r"budget[_ ]limit(?:ed|[_ ]reached)|token budget (?:exhausted|reached)", re.I
)
# Throttling. The canonical shape this arrives in is the client giving up:
# "exceeded retry limit, last status: 429 Too Many Requests". A bare 429 needs
# the same http/status/error context every other bare code needs, but the reason
# phrase and the error codes are unambiguous on their own. Kept ahead of
# TRANSIENT_RE by classify_text, because that message also carries the word
# "retry" and a burst of them is not a crash loop.
RATE_LIMIT_RE = re.compile(
    r"too many requests|rate[_ ]?limit(?:ed|_exceeded|s)?|"
    # A trailing decimal makes it a measurement, not a status: the agent reports
    # "median error 429.3mm" constantly, and \b alone accepts the dot.
    r"\b(?:http(?:\s+status)?|status|error)\s*[:=]?\s*429\b(?!\.\d)|"
    r"\bquota\s+exceeded\b",
    re.I,
)
# Bare status codes need an http/status/error context: agent output is full of
# frame counts and sample sizes ("1500 samples"), and the canonical reason
# phrases ("Bad Gateway", "Service Unavailable") are matched on their own.
# A bare "timeout" needs one too: the agent wraps its own shell commands in
# timeout(1) ("timeout --signal=INT --kill-after=10s 120s micromamba run ..."),
# so the word alone appears in perfectly healthy output.
#
# "Stream disconnected before completion" is the response stream dying mid-turn,
# and the TUI's own "Reconnecting... 1/5" ladder can exhaust without any of the
# suffixes matching: the observed tails are "idle timeout waiting for SSE", a
# prose "The server had an error while processing your request", and "Transport
# error: network error: error decoding response body". Only the fourth
# ("Transport error: timeout") hit a pattern, so the same outage classified
# three different ways. The prefix is unambiguous on its own -- nothing healthy
# reports a disconnected stream -- so match it without requiring the suffix.
# "Transport error" keeps its colon: bare, it would swallow the transport error
# of an optimal-transport loss, which is ordinary geometry vocabulary here.
TRANSIENT_RE = re.compile(
    r"internal[_ ]server[_ ]error|"
    # Claude Code prints its own API failures as "API Error: <reason>", and the
    # reasons seen so far ("Server error mid-response", "The operation timed
    # out", "unexpected error during processing") are all outages. 529 is
    # Anthropic's overloaded status.
    r"api error:|server error mid-response|overloaded(?:_error)?|"
    r"\b(?:http(?:\s+status)?|status|error)\s*[:=]?\s*(?:500|502|503|504|529)\b(?!\.\d)|"
    r"\btimed\s+out\b|request_timeout|"
    r"\b(?:error|stream|request|connection|read|write)\s*[:=]?\s*time\s*out\b|"
    r"connection (?:reset|closed|aborted)|"
    r"stream disconnected|idle timeout waiting for sse|transport error\s*:|"
    r"connectionreseterror|service unavailable|bad gateway|gateway timeout",
    re.I,
)
# An agent that gives up ends its turn cleanly, so only its wording separates a
# surrender from a delivery. Match the inability *and* its object: a healthy
# final summary routinely says it could not complete some sub-step ("I couldn't
# complete the rz sweep, so I fixed the hinge and all gates pass"), and only an
# abandonment aims that inability at the whole run. The apostrophe may be either
# ASCII or the U+2019 the model actually emits.
GAVE_UP_RE = re.compile(
    r"\b(?:could\s*n[o']?t|couldn['’]t|can\s*not|cannot|can['’]t|"
    r"(?:was|were|am|are)\s+(?:not\s+able|unable)\s+to|"
    r"(?:was|were)n['’]?t\s+able\s+to|unable\s+to)\s+"
    r"(?:fully\s+|successfully\s+|actually\s+)?"
    r"(?:complete|finish|deliver|produce)\b[^.\n]{0,80}?"
    r"\b(?:reconstruction|run|goal|objective|task|assignment)\b",
    re.I,
)
# A failure the terminal attributes to an agent id belongs to a spawned subagent,
# not to the session being supervised. See strip_thread_errors. Only the terminal
# fallback needs this: in the transcript, subagent traffic is isSidechain and
# classify_event skips it.
THREAD_ERROR_RE = re.compile(
    r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
    r"\s*:[^\n]*\berror[^\n]*",
    re.I,
)


def atomic_json(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with tmp.open("w", encoding="utf-8") as handle:
        json.dump(value, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, path)


def read_json(path: Path) -> dict[str, Any]:
    try:
        with path.open(encoding="utf-8") as handle:
            value = json.load(handle)
        return value if isinstance(value, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}


def session_name(run_dir: Path) -> str:
    clean = re.sub(r"[^A-Za-z0-9_-]+", "-", run_dir.name).strip("-") or "run"
    digest = hashlib.sha256(str(run_dir).encode()).hexdigest()[:8]
    return f"agent-{clean[:64]}-{digest}"


def sandbox_run_dir(run_dir: Path) -> str:
    return f"/home/ubuntu/articulated_script/runs/{run_dir.name}"


def classify_text(text: str) -> str | None:
    if OVERSIZE_RE.search(text):
        return "request_too_large"
    if USAGE_LIMIT_RE.search(text):
        return "usage_limited"
    if BUDGET_LIMIT_RE.search(text):
        return "budget_limited"
    # Before transient: the message that carries a 429 is itself a report of
    # exhausted retries, and its own words ("exceeded retry limit") would read as
    # a generic failure. Throttling needs the long ladder, not the 5s one.
    if RATE_LIMIT_RE.search(text):
        return "rate_limited"
    if TRANSIENT_RE.search(text):
        return "transient"
    return None


def structured_error_values(value: Any) -> list[Any]:
    """Extract structured error values, including JSON embedded in strings."""
    values: list[Any] = []
    if isinstance(value, dict):
        for key, item in value.items():
            if key.lower() in {"code", "status", "status_code", "type"}:
                values.append(item)
            values.extend(structured_error_values(item))
    elif isinstance(value, list):
        for item in value:
            values.extend(structured_error_values(item))
    elif isinstance(value, str):
        stripped = value.strip()
        if stripped.startswith(("{", "[")):
            try:
                values.extend(structured_error_values(json.loads(stripped)))
            except json.JSONDecodeError:
                pass
    return values


def classify_error(error: Any) -> str:
    """Prefer exact structured fields, then fall back to human-readable text."""
    values = {
        str(value).strip().lower().replace("-", "_")
        for value in structured_error_values(error)
    }
    if values & {"request_too_large", "context_length_exceeded", "prompt_too_long"}:
        return "request_too_large"
    # Claude Code stamps the transcript's API-error line with a bare code; these
    # are the ones it emits for credentials. Nothing a retry fixes.
    if values & {
        "authentication_failed",
        "authentication_error",
        "permission_error",
        "401",
        "403",
    }:
        return "auth_failed"
    if values & {"usage_limited", "usage_limit_reached"}:
        return "usage_limited"
    if values & {"budget_limited", "budget_limit_reached"}:
        return "budget_limited"
    if values & {
        "429",
        "rate_limit_exceeded",
        "rate_limited",
        "rate_limit",
        "rate_limit_error",
    }:
        return "rate_limited"
    if values & {
        "500",
        "502",
        "503",
        "504",
        "529",
        "internal_server_error",
        "request_timeout",
        # Claude Code's own codes for a dead or overloaded request.
        "server_error",
        "api_error",
        "overloaded",
        "overloaded_error",
        "timeout",
        "unknown",
    }:
        return "transient"
    return classify_text(event_text(error)) or "unclassified"


def strip_thread_errors(text: str) -> str:
    """Drop failures the terminal attributes to a spawned subagent.

    A window refiner's outage can surface on the orchestrator's own terminal as
    ``<agent-id>: Error - Internal server error`` while the orchestrator is
    already handling it -- respawning that window against the same immutable
    brief. Reading it as the supervised session's failure tears down a healthy
    orchestrator and kills every other live window with it.

    Consume the whole line, so no fragment of it can be classified either.
    """
    return THREAD_ERROR_RE.sub(" <subagent failure> ", text)


def event_text(value: Any) -> str:
    if isinstance(value, str):
        return value
    if isinstance(value, dict):
        return " ".join(event_text(item) for item in value.values())
    if isinstance(value, list):
        return " ".join(event_text(item) for item in value)
    return ""


def assistant_text(message: dict[str, Any]) -> str:
    """The text blocks of one assistant message, joined."""
    content = message.get("content")
    if isinstance(content, str):
        return content
    parts = []
    for block in content if isinstance(content, list) else []:
        if isinstance(block, dict) and block.get("type") == "text":
            parts.append(str(block.get("text", "")))
    return "\n".join(parts)


def block_text(block: dict[str, Any]) -> str:
    """The text of one ``tool_result`` block (``content`` is a string or text blocks)."""
    return assistant_text(block)


def event_time(event: dict[str, Any]) -> float:
    """When a transcript line was written, as a wall clock to compare with mtimes.

    Claude Code stamps every line ``timestamp: 2026-09-04T00:19:58.477Z``. That
    is preferred over the moment the supervisor happens to read the line: after
    a stall the tail catches up on a backlog, and a report read late would
    otherwise look newer than a resume that really came after it. Lines without
    a parseable stamp fall back to now.
    """
    stamp = event.get("timestamp")
    if isinstance(stamp, str):
        try:
            parsed = datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%S.%fZ")
        except ValueError:
            try:
                parsed = datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ")
            except ValueError:
                parsed = None
        if parsed is not None:
            return parsed.replace(tzinfo=timezone.utc).timestamp()
    return time.time()


def classify_event(event: dict[str, Any]) -> tuple[str | None, bool]:
    """Return (failure class, successful task completion) for one transcript line.

    Claude Code appends one JSON object per line to the session transcript. The
    lines that matter are ``assistant`` messages: one flagged ``isApiErrorMessage``
    is a failed request (its ``error`` field carries the code, its text the
    "API Error: ..." reason), and one whose ``stop_reason`` is ``end_turn`` is the
    end of the agent's turn. Tool calls are ``tool_use`` stops and ordinary
    progress. ``isSidechain`` lines belong to spawned subagents and are the
    orchestrator's to handle.

    An ``end_turn`` is not automatically a win. An agent that abandons the
    reconstruction ends its turn cleanly and apologises -- "I couldn't complete
    the reconstruction within this run." -- which is a *stall*: it leaves the run
    dir short of its gates. And an agent that stops to ask ("Should I proceed
    with the hinge?") has paused for input that, unattended, never comes; that
    is ``awaiting_input``, resumed in place with a nudge rather than rotated.
    """
    if event.get("type") != "assistant" or event.get("isSidechain"):
        return None, False
    message = event.get("message")
    if not isinstance(message, dict):
        return None, False
    if event.get("isApiErrorMessage"):
        error = {"code": event.get("error"), "message": assistant_text(message)}
        return classify_error(error), False
    if message.get("stop_reason") != "end_turn":
        return None, False
    text = assistant_text(message)
    if GAVE_UP_RE.search(text):
        return "goal_stalled", False
    if text.rstrip().endswith("?"):
        return "awaiting_input", False
    return None, True


