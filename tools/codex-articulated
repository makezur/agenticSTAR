#!/usr/bin/env bash
# Run Codex with host filesystem access limited by a Bubblewrap mount namespace.
set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/codex-articulated/paths.conf"
if [[ -r "$CONFIG_FILE" ]]; then
  # Generated by install_codex_bwrap.sh and owned by the current user.
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
fi

ARTICULATED_DIR="${ARTICULATED_DIR:-}"
BLENDER_DIR="${BLENDER_DIR:-$HOME/blender}"
MAMBA_ROOT="${MAMBA_ROOT:-$HOME/micromamba}"
# The micromamba binary may live inside the root (conda/miniforge layout) or on
# PATH at ~/.local/bin (standalone). Recorded by the installer; fall back to a
# best-effort lookup so an out-of-date config still works.
HOST_MAMBA_BIN="${HOST_MAMBA_BIN:-}"
HOST_CODEX_HOME="${HOST_CODEX_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/codex-articulated/codex-home}"
HOST_CODEX_BIN="${HOST_CODEX_BIN:-$(command -v codex 2>/dev/null || true)}"
HOST_RG_BIN="${HOST_RG_BIN:-}"
HOST_RUN_DIR=""
CODEX_PROVIDER="${ARTSCRIPT_CODEX_PROVIDER:-openai}"

die() {
  printf 'codex-articulated: %s\n' "$*" >&2
  exit 1
}

# Hidden mode: tear down one egress namespace once the launcher that owned it is
# gone. It exists so the launcher can still exec into Bubblewrap. An exec'd process
# cannot clean up after itself -- it *is* the sandbox -- and the alternative,
# keeping a wrapper alive to wait on it, hands the Codex TUI /dev/null for stdin
# (bash does that for an asynchronous command) and it exits with "stdin is not a
# terminal". Better to leave the process chain exactly as it was and put the
# cleanup out here.
#
# Everything it destroys is named after the slot, and a slot is reused the moment
# it looks free, so the reaper must prove the slot is still the one it was told
# about before touching it. Without that proof it tears down its successor: a
# replacement run that reuses the slot before the outgoing reaper wakes up loses
# its brokers and its namespace.
#
# The ownership record is the owner file, and the allocation lock is what makes
# reading it and acting on it one step, so a reclaim cannot land between another
# launcher's check and its own claim.
if [[ "${1:-}" == "--egress-reap" ]]; then
  reap_ns="$2"
  reap_slot="$3"
  reap_watch_pid="$4"
  reap_gen_dir="$5"
  reap_state_dir="$6"
  reap_owner="$7"
  reap_broker_pid="$8"
  reap_stub_pid="$9"
  while kill -0 "$reap_watch_pid" 2>/dev/null; do
    sleep 2
  done
  exec 9>"$reap_state_dir/alloc.lock"
  flock 9
  # The pids come from argv rather than the slot's pid files: by the time this
  # runs those files may describe a different tenant entirely.
  if [[ "$(awk 'NR == 1 { print $2 }' \
             "$reap_state_dir/$reap_ns.owner" 2>/dev/null)" == "$reap_owner" ]]; then
    kill "$reap_broker_pid" "$reap_stub_pid" 2>/dev/null || true
    ip netns delete "$reap_ns" 2>/dev/null || true
    ip link delete "cxe${reap_slot}h" 2>/dev/null || true
    # The egress log stays: it is the run's audit trail.
    rm -f "$reap_state_dir/$reap_ns".*.pid "$reap_state_dir/$reap_ns".*.ready \
          "$reap_state_dir/$reap_ns.owner"
  fi
  # The generated directory is this tenancy's own, named after it rather than the
  # slot, so it goes either way.
  rm -rf "$reap_gen_dir"
  flock -u 9
  exit 0
fi

PROVIDER_LIB="$(dirname "$(realpath "$0")")/codex-providers.sh"
if [[ ! -r "$PROVIDER_LIB" && -n "$ARTICULATED_DIR" ]]; then
  PROVIDER_LIB="$ARTICULATED_DIR/tools/codex-providers.sh"
fi
[[ -r "$PROVIDER_LIB" ]] ||
  die "Codex provider registry not found; rerun tools/install_codex_bwrap.sh"
# shellcheck source=/dev/null
source "$PROVIDER_LIB"

# Launcher options are accepted before the first Codex argument. Keeping them
# separate prevents a provider switch from leaking into Codex's own CLI parser.
while [[ $# -gt 0 ]]; do
  case "$1" in
    --run-dir)
      [[ -n "${2:-}" ]] || die "--run-dir requires a path"
      HOST_RUN_DIR="$2"
      shift 2
      ;;
    --codex-provider)
      [[ -n "${2:-}" ]] || die "--codex-provider requires openai"
      CODEX_PROVIDER="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done
CODEX_PROVIDER="$(codex_provider_validate "$CODEX_PROVIDER" || true)"
[[ -n "$CODEX_PROVIDER" ]] ||
  die "--codex-provider must be openai"

command -v bwrap >/dev/null 2>&1 ||
  die "bubblewrap is not installed; run tools/install_codex_bwrap.sh"
[[ -n "$HOST_CODEX_BIN" ]] || die "codex is not installed"
[[ -n "$ARTICULATED_DIR" ]] ||
  die "ARTICULATED_DIR is unset; rerun the installer or export it explicitly"

# Codex standalone bundles a static ripgrep binary outside its bin/ directory.
# Prefer the path recorded by the installer, then PATH, then that bundle layout.
if [[ -z "$HOST_RG_BIN" ]]; then
  HOST_RG_BIN="$(command -v rg 2>/dev/null || true)"
fi
if [[ -z "$HOST_RG_BIN" ]]; then
  codex_real="$(realpath "$HOST_CODEX_BIN")"
  bundled_rg="$(dirname "$(dirname "$codex_real")")/codex-path/rg"
  [[ -x "$bundled_rg" ]] && HOST_RG_BIN="$bundled_rg"
fi
[[ -n "$HOST_RG_BIN" ]] ||
  die "rg not found; rerun tools/install_codex_bwrap.sh after installing ripgrep"

# Resolve the micromamba binary if the config predates HOST_MAMBA_BIN.
if [[ -z "$HOST_MAMBA_BIN" ]]; then
  if [[ -x "$MAMBA_ROOT/bin/micromamba" ]]; then
    HOST_MAMBA_BIN="$MAMBA_ROOT/bin/micromamba"
  else
    HOST_MAMBA_BIN="$(command -v micromamba 2>/dev/null || true)"
  fi
fi
[[ -n "$HOST_MAMBA_BIN" ]] ||
  die "micromamba binary not found; rerun tools/install_codex_bwrap.sh"

ARTICULATED_DIR="$(realpath "$ARTICULATED_DIR")"
BLENDER_DIR="$(realpath "$BLENDER_DIR")"
MAMBA_ROOT="$(realpath "$MAMBA_ROOT")"
HOST_MAMBA_BIN="$(realpath "$HOST_MAMBA_BIN")"
HOST_CODEX_HOME="$(realpath "$HOST_CODEX_HOME")"
HOST_CODEX_BIN="$(realpath "$HOST_CODEX_BIN")"
HOST_RG_BIN="$(realpath "$HOST_RG_BIN")"
# Codex spawns helper executables (codex-code-mode-host, ...) from the directory
# of its own binary; inside the sandbox that is /opt/codex, so every executable
# sibling named codex-* is bound there too.
HOST_CODEX_HELPERS=()
for helper in "$(dirname "$HOST_CODEX_BIN")"/codex-*; do
  [[ -f "$helper" && -x "$helper" ]] && HOST_CODEX_HELPERS+=("$helper")
done

[[ -d "$ARTICULATED_DIR" ]] || die "project not found: $ARTICULATED_DIR"
[[ -x "$BLENDER_DIR/blender" ]] || die "Blender not found: $BLENDER_DIR/blender"

# Blender finds its bundled resources (scripts/, python/, datafiles/) by walking
# up from its own executable path — which fails under the stub /proc below, where
# /proc/self/exe is pinned to micromamba and there is no mount table to read
# ("could not get a list of mounted file-systems"), and bpy never imports. Locate
# the adjacent <major>.<minor>/ resource dir on the host and hand it to Blender
# explicitly via BLENDER_SYSTEM_RESOURCES so discovery is not needed. Kept even
# when the sandbox gets a real procfs and the walk would work: one code path for
# both, and being explicit costs nothing.
BLENDER_RESOURCES=""
for candidate in "$BLENDER_DIR"/[0-9]*.[0-9]*; do
  [[ -d "$candidate/scripts" && -d "$candidate/python" ]] || continue
  BLENDER_RESOURCES="$candidate"
  break
done
[[ -n "$BLENDER_RESOURCES" ]] ||
  die "Blender resources (<ver>/ dir with scripts/ + python/) not found under $BLENDER_DIR"
[[ -d "$MAMBA_ROOT/envs/artscript" ]] ||
  die "micromamba environment not found: $MAMBA_ROOT/envs/artscript"
[[ -x "$HOST_MAMBA_BIN" ]] || die "micromamba binary not found: $HOST_MAMBA_BIN"
[[ -d "$HOST_CODEX_HOME" ]] || die "Codex state not found: $HOST_CODEX_HOME"
[[ -x "$HOST_CODEX_BIN" ]] || die "Codex binary not found: $HOST_CODEX_BIN"
[[ -x "$HOST_RG_BIN" ]] || die "rg binary not found: $HOST_RG_BIN"
[[ -r "$HOST_CODEX_HOME/config.toml" ]] ||
  die "Codex config missing from $HOST_CODEX_HOME; rerun tools/install_codex_bwrap.sh"
grep -q '"OPENAI_API_KEY"' "$HOST_CODEX_HOME/auth.json" 2>/dev/null ||
  die "$HOST_CODEX_HOME/auth.json has no API-key login.
Export OPENAI_API_KEY and rerun tools/install_codex_bwrap.sh once to provision it."

SANDBOX_PROJECT="/home/ubuntu/articulated_script"
SANDBOX_BLENDER="/home/ubuntu/blender"
SANDBOX_CODEX_HOME="/home/ubuntu/.codex"
# The mamba root mounts read-only at /opt/mamba, but the micromamba binary lives
# outside the root on some hosts, so it is mounted separately and put on PATH.
SANDBOX_MAMBA_BIN="/opt/mamba-bin/micromamba"
SANDBOX_RUNS="$SANDBOX_PROJECT/runs"
# Project subtrees the agent must not be able to modify. The project itself is
# bound read-write -- the agent writes scene.py, reports and its run dir through
# it -- so each of these is bound read-only OVER that bind; bwrap applies mounts
# in order, and reordering them silently reopens the hole.
#
# `harness` is the code the run is scored by and `conventions` the rules it is
# held to, so a run that could edit them could grade itself, and `tools` is this
# launcher, the supervisor and the egress broker -- the sandbox's own
# construction. None of
# that is a run's to rewrite, least of all because the project dir is ONE host
# checkout shared by every run on the box: a write here reaches every other run
# on the host.
SANDBOX_RO_PROJECT_DIRS=(conventions harness tools)
SANDBOX_RUN_DIR=""

if [[ -n "$HOST_RUN_DIR" ]]; then
  HOST_RUN_DIR="$(realpath "$HOST_RUN_DIR")"
  [[ -d "$HOST_RUN_DIR" ]] || die "run directory not found: $HOST_RUN_DIR"
  RUN_BASENAME="$(basename "$HOST_RUN_DIR")"
  [[ -n "$RUN_BASENAME" && "$RUN_BASENAME" != "." && "$RUN_BASENAME" != "/" ]] ||
    die "run directory has no usable basename: $HOST_RUN_DIR"
  SANDBOX_RUN_DIR="$SANDBOX_RUNS/$RUN_BASENAME"
fi

# ---------------------------------------------------------------------------
# Network confinement.
#
# Confine the sandbox's network to the provider API; a model with open internet
# can fetch its own reference data.
#
# Codex's own command sandbox cannot be the boundary for this, which is why the
# work is done here instead -- see the note next to codex_argv at the bottom for
# what it does under this launcher. A layer that can
# no-op without saying so is not one to rely on.
#
# So egress is denied by construction instead: the sandbox runs in a network
# namespace whose only neighbour is one veth peer, with no NAT behind it. Nothing
# inside can reach the internet at all -- not by hostname, not by IP literal, not
# by reconfiguring the interface (CAP_NET_ADMIN is dropped and the namespace is
# owned by this process's user namespace). The single exception is
# tools/egress_broker.py, which relays a fixed list of host:port pairs chosen
# here and logs every connection it carries. Note what that log is and is not: a
# blocked destination never reaches the relay, because the kernel refuses it
# inside the namespace, so the log shows what a run did talk to rather than what
# it tried to.
#
#   SANDBOX_NET=allowlist  (default) confinement as described above
#   SANDBOX_NET=open                 the host's network, unconfined;
#                                    for debugging the launcher, not for runs
#   SANDBOX_EGRESS_HOSTS             override the allowed host:port list
SANDBOX_NET="${SANDBOX_NET:-allowlist}"
case "$SANDBOX_NET" in
  allowlist | open) ;;
  *) die "SANDBOX_NET must be 'allowlist' or 'open': $SANDBOX_NET" ;;
esac

netns_prefix=()
if [[ "$SANDBOX_NET" == allowlist ]]; then
  command -v ip >/dev/null 2>&1 ||
    die "iproute2 (ip) is required for SANDBOX_NET=allowlist"
  [[ "$(id -u)" -eq 0 ]] ||
    die "SANDBOX_NET=allowlist needs CAP_NET_ADMIN to create the namespace"

  # The allowlist is the provider's inference endpoint (codex-providers.sh):
  # api.openai.com and nothing else. The sinkhole names anything genuinely
  # missing, so there is no need to guess ahead of it. SANDBOX_EGRESS_HOSTS
  # overrides the list (e.g. to add a second API host).
  if [[ -z "${SANDBOX_EGRESS_HOSTS:-}" ]]; then
    mapfile -t egress_hosts < <(
      codex_provider_egress_hosts "$CODEX_PROVIDER"
    )
  else
    read -r -a egress_hosts <<< "$SANDBOX_EGRESS_HOSTS"
  fi
  [[ "${#egress_hosts[@]}" -gt 0 ]] || die "SANDBOX_EGRESS_HOSTS is empty"

  # web_search is a model-side tool: the fetch happens on the provider's network,
  # not this one, so egress confinement cannot see or stop it. Every active config
  # layer must keep it "disabled".
  configs_to_check=(
    "$HOST_CODEX_HOME/config.toml"
    "$ARTICULATED_DIR/.codex/config.toml"
  )
  for codex_config in "${configs_to_check[@]}"; do
    [[ -r "$codex_config" ]] || continue
    while IFS= read -r web_search_line; do
      web_search_value="${web_search_line#*=}"
      web_search_value="${web_search_value//[[:space:]\"]/}"
      [[ "$web_search_value" == "disabled" ]] ||
        die "web_search must be \"disabled\" in $codex_config under
SANDBOX_NET=allowlist; model-side search bypasses this namespace."
    done < <(grep -iE '^ *web_search *=' "$codex_config" || true)
  done
  for codex_arg in "$@"; do
    if [[ "$codex_arg" == "--search" ]]; then
      die "--search enables model-side web search, which is not confined by
SANDBOX_NET=allowlist."
    fi
  done


  # Overridable only so the reclaim decisions below can be tested against a
  # directory of fixtures instead of the live one: getting them wrong takes the
  # network away from a running agent, which is not a thing to find out in
  # production twice.
  EGRESS_STATE_DIR="${CODEX_EGRESS_STATE_DIR:-/run/codex-egress}"
  mkdir -p "$EGRESS_STATE_DIR"

  # One slot per concurrent sandbox: slot n owns 10.99.n.0/24 and the cxe<n>*
  # interface pair. Allocation is serialised so parallel supervisors cannot pick
  # the same subnet.
  #
  # Reclaiming orphans is part of allocating and so belongs inside the same lock.
  exec 9>"$EGRESS_STATE_DIR/alloc.lock"
  flock 9

  # Reap namespaces whose launcher was killed before its reaper could run, so a
  # crashed run does not leak a slot or a subnet. Liveness is the owner pid, which
  # is the launcher itself -- it execs into Bubblewrap, so that one pid is alive
  # for exactly as long as the sandbox is.
  #
  # A namespace with no owner file is not thereby abandoned: a launcher that
  # predates the owner file is still a running agent, and reclaiming its subnet
  # would take the network out from under it. Fall back to the broker pid, which is
  # the older answer to the same question, and only reclaim when neither says the
  # slot is in use.
  for stale in $(ip netns list 2>/dev/null | awk '{print $1}'); do
    case "$stale" in codex-egress-*) ;; *) continue ;; esac
    stale_pid="$(awk 'NR == 1 { print $1 }' \
                   "$EGRESS_STATE_DIR/$stale.owner" 2>/dev/null || true)"
    if [[ -z "$stale_pid" ]]; then
      stale_pid="$(cat "$EGRESS_STATE_DIR/$stale.broker.pid" 2>/dev/null || true)"
    fi
    [[ -n "$stale_pid" ]] && kill -0 "$stale_pid" 2>/dev/null && continue
    for stale_pidfile in "$EGRESS_STATE_DIR/$stale.broker.pid" \
                         "$EGRESS_STATE_DIR/$stale.stub.pid"; do
      [[ -r "$stale_pidfile" ]] &&
        kill "$(cat "$stale_pidfile")" 2>/dev/null || true
    done
    ip netns delete "$stale" 2>/dev/null || true
    ip link delete "cxe${stale#codex-egress-}h" 2>/dev/null || true
    rm -rf "$EGRESS_STATE_DIR/$stale".gen.* 2>/dev/null || true
    rm -f "$EGRESS_STATE_DIR/$stale".*.pid "$EGRESS_STATE_DIR/$stale".*.ready \
          "$EGRESS_STATE_DIR/$stale.owner"
  done

  EGRESS_SLOT=""
  for candidate in $(seq 1 200); do
    ip netns list 2>/dev/null | awk '{print $1}' |
      grep -qx "codex-egress-$candidate" && continue
    ip link show "cxe${candidate}h" >/dev/null 2>&1 && continue
    EGRESS_SLOT="$candidate"
    break
  done
  [[ -n "$EGRESS_SLOT" ]] || die "no free egress slot; too many sandboxes running"

  EGRESS_NS="codex-egress-$EGRESS_SLOT"
  EGRESS_VETH_HOST="cxe${EGRESS_SLOT}h"
  EGRESS_VETH_NS="cxe${EGRESS_SLOT}c"
  EGRESS_NET="10.99.$EGRESS_SLOT"
  EGRESS_BROKER_IP="$EGRESS_NET.1"   # relay side, reachable from the sandbox
  EGRESS_SANDBOX_IP="$EGRESS_NET.2"  # the sandbox's only address
  EGRESS_GEN_DIR="$(mktemp -d "$EGRESS_STATE_DIR/$EGRESS_NS.gen.XXXXXX")"
  EGRESS_LOG="$EGRESS_STATE_DIR/$EGRESS_NS.log"
  if [[ -n "$HOST_RUN_DIR" ]]; then
    mkdir -p "$HOST_RUN_DIR/supervisor"
    EGRESS_LOG="$HOST_RUN_DIR/supervisor/egress.log"
  fi

  egress_teardown() {
    for pidfile in "$EGRESS_STATE_DIR/$EGRESS_NS.broker.pid" \
                   "$EGRESS_STATE_DIR/$EGRESS_NS.stub.pid"; do
      [[ -r "$pidfile" ]] && kill "$(cat "$pidfile")" 2>/dev/null || true
    done
    ip netns delete "$EGRESS_NS" 2>/dev/null || true
    ip link delete "$EGRESS_VETH_HOST" 2>/dev/null || true
    rm -rf "$EGRESS_GEN_DIR"
    # The egress log is the audit trail for the run; only the transient state
    # goes away with the namespace.
    rm -f "$EGRESS_STATE_DIR/$EGRESS_NS".*.pid \
          "$EGRESS_STATE_DIR/$EGRESS_NS".*.ready \
          "$EGRESS_STATE_DIR/$EGRESS_NS.owner"
  }
  trap egress_teardown EXIT

  # Names this tenancy of the slot, as opposed to the slot itself. The pid is what
  # says whether it is still running; the suffix distinguishes it from the next
  # tenancy in the rare case the kernel hands out the same pid again.
  EGRESS_OWNER="$$-$(date +%s%N)"

  ip netns add "$EGRESS_NS"
  ip link add "$EGRESS_VETH_HOST" type veth peer name "$EGRESS_VETH_NS"
  ip link set "$EGRESS_VETH_NS" netns "$EGRESS_NS"
  printf '%d %s\n' "$$" "$EGRESS_OWNER" > "$EGRESS_STATE_DIR/$EGRESS_NS.owner"
  # The slot is taken now that the namespace, the interface and the owner file
  # exist, which is what the loop above looks for. Release the lock here rather
  # than letting it fall to process exit: holding it for the life of the run would
  # make a second launcher wait hours for the first to finish instead of taking the
  # next slot.
  flock -u 9
  exec 9>&-
  ip addr add "$EGRESS_BROKER_IP/24" dev "$EGRESS_VETH_HOST"
  ip link set "$EGRESS_VETH_HOST" up
  ip -n "$EGRESS_NS" addr add "$EGRESS_SANDBOX_IP/24" dev "$EGRESS_VETH_NS"
  ip -n "$EGRESS_NS" link set "$EGRESS_VETH_NS" up
  ip -n "$EGRESS_NS" link set lo up
  # Deliberately no default route: an unlisted destination fails immediately with
  # ENETUNREACH rather than hanging until a timeout.

  # Each allowed host gets its own relay address, so the hosts file below is what
  # names a destination and the relay itself has nothing to parse.
  broker_maps=()
  hosts_file="$EGRESS_GEN_DIR/hosts"
  {
    printf '127.0.0.1 localhost\n'
    printf '::1 localhost ip6-localhost ip6-loopback\n'
  } > "$hosts_file"
  alias_index=10
  for entry in "${egress_hosts[@]}"; do
    entry_host="${entry%:*}"
    entry_port="${entry##*:}"
    [[ "$entry_host" != "$entry" && -n "$entry_port" ]] ||
      die "SANDBOX_EGRESS_HOSTS entries must be host:port: $entry"
    alias_ip="$EGRESS_NET.$alias_index"
    ip addr add "$alias_ip/24" dev "$EGRESS_VETH_HOST"
    broker_maps+=(--map "$alias_ip:$entry_port=$entry_host:$entry_port")
    printf '%s %s\n' "$alias_ip" "$entry_host" >> "$hosts_file"
    alias_index=$((alias_index + 1))
  done

  # The only resolver in the namespace is the sinkhole below, which refuses
  # everything and logs the name. So a name outside the hosts file fails at once
  # and on the record. Two independent layers still: no name, and no route.
  printf 'nameserver 127.0.0.1\noptions timeout:1 attempts:1\n' \
    > "$EGRESS_GEN_DIR/resolv.conf"

  # The relay runs out here, in the host's namespace. The sandbox cannot see it,
  # signal it, or change what it points at.
  # Sibling of this script, not $ARTICULATED_DIR/tools: paths.conf always wins
  # over the environment, so a launcher run out of a worktree must still use its
  # own relay rather than the one in the configured checkout.
  EGRESS_BROKER="$(dirname "$(realpath "$0")")/egress_broker.py"
  [[ -r "$EGRESS_BROKER" ]] || die "egress relay not found: $EGRESS_BROKER"

  broker_ready="$EGRESS_STATE_DIR/$EGRESS_NS.broker.ready"
  python3 "$EGRESS_BROKER" \
    --label relay --log "$EGRESS_LOG" --ready-file "$broker_ready" \
    --verify-upstreams \
    "${broker_maps[@]}" >> "$EGRESS_LOG" 2>&1 &
  EGRESS_BROKER_PID="$!"
  printf '%d\n' "$EGRESS_BROKER_PID" > "$EGRESS_STATE_DIR/$EGRESS_NS.broker.pid"

  await_ready() {
    for _ in $(seq 1 100); do
      [[ -e "$1" ]] && return 0
      sleep 0.1
    done
    die "the egress relay did not come up.
  It reports ready only once every allowed destination answers, so this is either
  a bind failure or a destination that is down or misnamed.
  The allowlist is SANDBOX_EGRESS_HOSTS, defaulting to provider '$CODEX_PROVIDER'.
  The last line of $EGRESS_LOG says which."
  }

  # Bring the relay fully up before starting anything inside the namespace, so a
  # relay that fails to bind or to reach an allowed destination is reported as
  # exactly that, not as a knock-on failure of whatever started after it. Both
  # processes write to the same log, and a launcher that dies with "the egress
  # relay did not come up" should mean the relay, not the resolver.
  await_ready "$broker_ready"

  # Inside the namespace: the DNS sinkhole, i.e. the resolver the sandbox's
  # resolv.conf points at. It relays nothing (no --map); every name not in the
  # generated hosts file lands there and gets written down before being refused,
  # which is what turns both a cheating attempt and a renamed endpoint into a line
  # in the log instead of a silence.
  stub_ready="$EGRESS_STATE_DIR/$EGRESS_NS.stub.ready"
  ip netns exec "$EGRESS_NS" python3 "$EGRESS_BROKER" \
    --label sandbox-side --log "$EGRESS_LOG" --ready-file "$stub_ready" \
    --verify-upstreams --dns-sinkhole 127.0.0.1:53 >> "$EGRESS_LOG" 2>&1 &
  EGRESS_STUB_PID="$!"
  printf '%d\n' "$EGRESS_STUB_PID" > "$EGRESS_STATE_DIR/$EGRESS_NS.stub.pid"

  await_ready "$stub_ready"

  netns_prefix=(ip netns exec "$EGRESS_NS")
fi

# Preserve the caller's location when launched from somewhere inside the repo.
case "$PWD/" in
  "$ARTICULATED_DIR/"*)
    relative_cwd="${PWD#"$ARTICULATED_DIR"}"
    sandbox_cwd="${SANDBOX_PROJECT}${relative_cwd}"
    ;;
  *)
    sandbox_cwd="$SANDBOX_PROJECT"
    ;;
esac

bwrap_args=(
  --die-with-parent
  --new-session
  --unshare-all
  --share-net
  --uid 0
  --gid 0
  --cap-drop ALL
  --clearenv
  --dev /dev
  --tmpfs /dev/shm
  --tmpfs /tmp
  --tmpfs /run
  --tmpfs /var
  --dir /var/tmp
  --dir /home
  --tmpfs /home/ubuntu
  --dir /opt
  --dir /opt/codex
  --dir /etc
)

# A procfs of the sandbox's own pid namespace, when the kernel will give us one.
#
# Never bind the host /proc wholesale: procfs contents follow the pid namespace of
# the mount rather than the reader, so the host's mount shows host processes and
# /proc/<pid>/root walks straight out of the filesystem boundary. A fresh mount is
# different -- bwrap unshares pids, so a procfs mounted inside shows only the
# sandbox's own processes, and /proc/1 is its own Bubblewrap rather than the host's.
#
# The kernel reports only EPERM for this. Mounting procfs from inside a user
# namespace is refused if the procfs the caller can already see has a locked
# submount covering something a fresh mount would expose (fs/namespace.c,
# mount_too_revealing). On hosts running the NVIDIA container toolkit that is
# typically one path: a tmpfs over /proc/driver/nvidia/params. Clearing it in a
# private mount namespace of our own -- which the host never sees -- is enough
# for the mount to be permitted.
#
# Without it, /proc is a tmpfs holding eight files, and everything built on procps
# reports `Error, do this: mount -t proc proc /proc` and exits non-zero: ps, top,
# pgrep, free, and anything reading /proc/self/status, including psutil. The
# fallback below keeps that behaviour for hosts where the mount is
# genuinely refused, because a confined sandbox with an awkward /proc beats an
# unconfined one.
unshare_proc=(
  unshare --mount --propagation private
  bash -c '
    while read -r masked; do
      umount -l "$masked" 2>/dev/null || true
    done < <(awk "\$5 ~ /^\/proc\// { print \$5 }" /proc/self/mountinfo | sort -r)
    exec "$@"
  ' codex-articulated-proc
)
proc_prefix=()
if "${unshare_proc[@]}" bwrap --unshare-all --share-net --uid 0 --gid 0 \
     --cap-drop ALL --proc /proc --ro-bind /usr /usr --symlink usr/lib /lib \
     --symlink usr/lib64 /lib64 --symlink usr/bin /bin /bin/true 2>/dev/null; then
  proc_prefix=("${unshare_proc[@]}")
  # /proc/self/exe is then simply correct, for every process rather than for the one
  # the fallback's symlink names.
  bwrap_args+=(--proc /proc)

  # A real procfs brings back the parts of it that are not about this sandbox, so
  # cover them. Bubblewrap does this for sysrq-trigger, irq and bus but not for
  # /proc/sys: it skips a path whose directory is not writable, and /proc/sys is
  # mode 0555, while the sysctls inside it are 0644 and this process is real root.
  # Measured, not assumed -- before this line a write to
  # /proc/sys/kernel/core_pattern from inside the sandbox succeeded, which is a
  # host-side program name the kernel runs on the next core dump.
  bwrap_args+=(--ro-bind /proc/sys /proc/sys)
  # Reading host memory, and the two files that list every task on the machine by
  # name -- which would hand an agent the other runs it is confined away from,
  # having found nothing in the filesystem. Same set container runtimes mask, minus
  # the ones this kernel does not have.
  for path in \
    /proc/kcore \
    /proc/keys \
    /proc/key-users \
    /proc/latency_stats \
    /proc/sched_debug \
    /proc/timer_list \
    /proc/timer_stats \
    /proc/config.gz \
    /proc/vmcore; do
    [[ -f "$path" ]] && bwrap_args+=(--ro-bind /dev/null "$path")
  done
  for path in /proc/acpi /proc/asound /proc/scsi /proc/fs; do
    [[ -d "$path" ]] && bwrap_args+=(--tmpfs "$path")
  done
else
  bwrap_args+=(--tmpfs /proc)
  for path in \
    /proc/cpuinfo \
    /proc/loadavg \
    /proc/meminfo \
    /proc/stat \
    /proc/sys/kernel/osrelease \
    /proc/sys/kernel/ostype \
    /proc/uptime \
    /proc/version; do
    [[ -e "$path" ]] && bwrap_args+=(--ro-bind "$path" "$path")
  done
  bwrap_args+=(--dir /proc/self)
  bwrap_args+=(--symlink "$SANDBOX_MAMBA_BIN" /proc/self/exe)
fi

# Commands may read the host's immutable executables and libraries, but not its
# root filesystem. Preserve usr-merge symlinks used by current Ubuntu releases.
bwrap_args+=(--ro-bind /usr /usr)
for path in /bin /sbin /lib /lib64; do
  if [[ -L "$path" ]]; then
    bwrap_args+=(--symlink "$(readlink "$path")" "$path")
  elif [[ -e "$path" ]]; then
    bwrap_args+=(--ro-bind "$path" "$path")
  fi
done

# Expose only non-secret system configuration needed by TLS, DNS, Git, fonts,
# dynamic linking, and Blender graphics discovery. In particular, /etc itself
# is not mounted and files such as /etc/shadow remain inaccessible.
for path in \
  /etc/alternatives \
  /etc/ca-certificates \
  /etc/fonts \
  /etc/ld.so.conf.d \
  /etc/OpenCL \
  /etc/ssl \
  /etc/vulkan \
  /etc/host.conf \
  /etc/hostname \
  /etc/hosts \
  /etc/gai.conf \
  /etc/gitconfig \
  /etc/group \
  /etc/ld.so.cache \
  /etc/ld.so.conf \
  /etc/localtime \
  /etc/nsswitch.conf \
  /etc/passwd \
  /etc/resolv.conf; do
  [[ -e "$path" || -L "$path" ]] && bwrap_args+=(--ro-bind "$path" "$path")
done

# Confined runs get a generated hosts file naming only the allowed destinations
# and a resolver that answers nothing. These come after the loop above on purpose:
# bwrap applies mounts in order, so they shadow the host copies just bound.
if [[ "$SANDBOX_NET" == allowlist ]]; then
  bwrap_args+=(--ro-bind "$EGRESS_GEN_DIR/hosts" /etc/hosts)
  bwrap_args+=(--ro-bind "$EGRESS_GEN_DIR/resolv.conf" /etc/resolv.conf)
  # Names the destination --check-isolation probes as the one that must work.
  bwrap_args+=(--setenv SANDBOX_EGRESS_CHECK "${egress_hosts[0]}")
fi

# Hardware metadata and GPU devices are needed by Blender. Device mounts are
# deliberately limited instead of exposing all host devices.
#
# SANDBOX_GPUS (comma ids, e.g. "0" or "2,3") binds only that GPU subset into
# the sandbox. This is the ONLY EEVEE GPU-pinning lever that works for a
# sandboxed agent: EEVEE ignores CUDA_VISIBLE_DEVICES and grabs the first GPU
# its EGL context can see, and bwrap can't nest (CAP ALL is dropped), so the
# assignment must happen HERE. Unset -> all GPUs (previous behavior); the pool
# inside the sandbox then sizes its pool off the visible node count.
[[ -d /sys ]] && bwrap_args+=(--ro-bind /sys /sys)
[[ -d /dev/dri ]] && bwrap_args+=(--dev-bind /dev/dri /dev/dri)
shopt -s nullglob
if [[ -n "${SANDBOX_GPUS:-}" ]]; then
  IFS=',' read -r -a gpu_ids <<< "$SANDBOX_GPUS"
  for gpu_id in "${gpu_ids[@]}"; do
    gpu_id="${gpu_id// /}"
    [[ -e "/dev/nvidia$gpu_id" ]] ||
      die "SANDBOX_GPUS: /dev/nvidia$gpu_id does not exist"
    bwrap_args+=(--dev-bind "/dev/nvidia$gpu_id" "/dev/nvidia$gpu_id")
  done
  for device in /dev/nvidiactl /dev/nvidia-modeset \
                /dev/nvidia-uvm /dev/nvidia-uvm-tools; do
    [[ -e "$device" ]] && bwrap_args+=(--dev-bind "$device" "$device")
  done
else
  for device in /dev/nvidia[0-9]* /dev/nvidiactl /dev/nvidia-modeset \
                /dev/nvidia-uvm /dev/nvidia-uvm-tools; do
    bwrap_args+=(--dev-bind "$device" "$device")
  done
fi
[[ -d /dev/nvidia-caps ]] &&
  bwrap_args+=(--dev-bind /dev/nvidia-caps /dev/nvidia-caps)
shopt -u nullglob

bwrap_args+=(
  --ro-bind "$HOST_CODEX_BIN" /opt/codex/codex
  --ro-bind "$HOST_RG_BIN" /opt/codex/rg
)
for helper in ${HOST_CODEX_HELPERS[@]+"${HOST_CODEX_HELPERS[@]}"}; do
  bwrap_args+=(--ro-bind "$helper" "/opt/codex/$(basename "$helper")")
done
bwrap_args+=(
  --bind "$ARTICULATED_DIR" "$SANDBOX_PROJECT"
  --tmpfs "$SANDBOX_RUNS"
  --ro-bind "$BLENDER_DIR" "$SANDBOX_BLENDER"
  --ro-bind "$MAMBA_ROOT" /opt/mamba
  --ro-bind "$HOST_MAMBA_BIN" "$SANDBOX_MAMBA_BIN"
  --bind "$HOST_CODEX_HOME" "$SANDBOX_CODEX_HOME"
)
# Read-only over the read-write project bind just added, so ordering is load
# bearing: these must follow it. See SANDBOX_RO_PROJECT_DIRS.
for ro_project_dir in "${SANDBOX_RO_PROJECT_DIRS[@]}"; do
  if [[ -d "$ARTICULATED_DIR/$ro_project_dir" ]]; then
    bwrap_args+=(
      --ro-bind "$ARTICULATED_DIR/$ro_project_dir" "$SANDBOX_PROJECT/$ro_project_dir"
    )
  fi
done
# The history is hidden rather than made read-only, because here READING is the
# leak: the task is to reconstruct from images, not to read the repo's history.
#
# Nothing in the sandbox needs it: harness's _harness_rev is best-effort by
# construction, and the bookkeeping ledger runs git against its own per-run
# repository inside the run dir, which this does not touch.
#
# A checkout keeps .git as a directory; a git worktree keeps it as a FILE naming
# a gitdir that lives outside the project and is never bound in. Shadow whichever
# this is -- a tmpfs cannot mount over a file, and /dev/null cannot mount over a
# directory. Either way git reports no repository and stops walking up.
if [[ -d "$ARTICULATED_DIR/.git" ]]; then
  bwrap_args+=(--tmpfs "$SANDBOX_PROJECT/.git")
elif [[ -e "$ARTICULATED_DIR/.git" ]]; then
  bwrap_args+=(--ro-bind /dev/null "$SANDBOX_PROJECT/.git")
fi

# Mount the selected host run at one stable sandbox path. Its host parent is
# irrelevant and every sibling run remains unreachable.
if [[ -n "$SANDBOX_RUN_DIR" ]]; then
  bwrap_args+=(--dir "$SANDBOX_RUN_DIR")
  bwrap_args+=(--bind "$HOST_RUN_DIR" "$SANDBOX_RUN_DIR")
  bwrap_args+=(--setenv ISOLATED_RUN_DIR "$SANDBOX_RUN_DIR")
  # The run's CONTRACT files, pinned read-only over the writable run bind: the
  # module set (which gates this run carries -- harness/core/modules.py) and the
  # task document run.sh assembled from it. A file bind on top of a bind mount
  # is immutable AND undeletable from inside (rm/mv fail with EBUSY), so the
  # agent can read what it was given but not edit its own gates or instructions.
  # Skipped when absent: a run scaffolded before these existed still resumes.
  for pinned in modules.json AGENT_TASK.md; do
    [[ -f "$HOST_RUN_DIR/$pinned" ]] &&
      bwrap_args+=(--ro-bind "$HOST_RUN_DIR/$pinned" "$SANDBOX_RUN_DIR/$pinned")
  done
fi

# Pass through only control-plane environment variables needed by the terminal
# and configured model provider. Arbitrary host secrets are not inherited.
for name in \
  TERM COLORTERM LANG LC_ALL \
  HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy; do
  if [[ -n "${!name:-}" ]]; then
    bwrap_args+=(--setenv "$name" "${!name}")
  fi
done

bwrap_args+=(
  --setenv HOME /home/ubuntu
  --setenv USER ubuntu
  --setenv LOGNAME ubuntu
  --setenv CODEX_HOME "$SANDBOX_CODEX_HOME"
  --setenv MAMBA_ROOT_PREFIX /opt/mamba
  --setenv TMPDIR /tmp
  --setenv XDG_CACHE_HOME /tmp/.cache
  --setenv PYTHONDONTWRITEBYTECODE 1
  --setenv BLENDER "$SANDBOX_BLENDER/blender"
  --setenv BLENDER_SYSTEM_RESOURCES "$SANDBOX_BLENDER/${BLENDER_RESOURCES#"$BLENDER_DIR"/}"
  --setenv LD_LIBRARY_PATH "$SANDBOX_BLENDER/lib:/usr/local/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64"
  # Repo wrappers expose optional artscript CLIs without adding the conda env's
  # libraries globally (which could interfere with Blender or Codex).
  --setenv PATH "/opt/codex:/opt/mamba-bin:/opt/mamba/bin:/home/ubuntu/blender:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$SANDBOX_PROJECT/tools/bin"
  --chdir "$sandbox_cwd"
)
bwrap_args+=(--setenv ARTSCRIPT_CODEX_PROVIDER "$CODEX_PROVIDER")

if [[ "${1:-}" == "--check-isolation" ]]; then
  "${netns_prefix[@]}" "${proc_prefix[@]}" bwrap "${bwrap_args[@]}" /bin/bash -ceuo pipefail '
    [[ -w /home/ubuntu/articulated_script ]]
    for protected_dir in conventions harness; do
      probe="/home/ubuntu/articulated_script/$protected_dir/.codex-isolation-write-test"
      if touch "$probe" 2>/dev/null; then
        rm -f "$probe"
        printf "isolation check: %s is writable\n" "$protected_dir" >&2
        exit 1
      fi
    done
    [[ "$XDG_CACHE_HOME" == /tmp/.cache ]]
    mkdir -p "$XDG_CACHE_HOME"
    [[ -w "$XDG_CACHE_HOME" ]]
    [[ -x /home/ubuntu/blender/blender ]]
    [[ ! -w /home/ubuntu/blender ]]
    [[ -d /opt/mamba/envs/artscript ]]
    [[ ! -e /root ]]
    # /proc/1 is either absent (the tmpfs fallback) or the Bubblewrap belonging to
    # this sandbox, never the init of the host. Assert that by what is behind it
    # rather than by pid count: pid 1 having a root the host would recognise is the
    # failure that matters, and it is the one an accidentally bound host procfs
    # would produce.
    if [[ -e /proc/1/root ]]; then
      [[ ! -e /proc/1/root/root ]]
      [[ -d /proc/1/root/home/ubuntu/articulated_script ]]
      # And nothing outside this sandbox is visible at all.
      [[ "$(find /proc -maxdepth 1 -regex ".*/[0-9]+" | wc -l)" -lt 32 ]]
      # The parts of procfs that are a way out stay read-only, and the ones that
      # describe the machine rather than this sandbox stay unreadable.
      [[ ! -w /proc/sysrq-trigger ]]
      [[ ! -w /proc/sys/kernel/core_pattern ]]
      ! head -c 1 /proc/kcore >/dev/null 2>&1
      [[ ! -e /proc/timer_list ]] || ! head -c 1 /proc/timer_list >/dev/null 2>&1
    fi
    [[ "$(stat -f -c %T /tmp)" == "tmpfs" ]]
    [[ "$(stat -f -c %T /home/ubuntu/articulated_script/runs)" == "tmpfs" ]]
    if [[ -n "${ISOLATED_RUN_DIR:-}" ]]; then
      [[ -w "$ISOLATED_RUN_DIR" ]]
      # the pinned contract files: present ones must refuse a write AND an unlink
      for pinned in modules.json AGENT_TASK.md; do
        [[ -e "$ISOLATED_RUN_DIR/$pinned" ]] || continue
        if : >> "$ISOLATED_RUN_DIR/$pinned" 2>/dev/null; then
          printf "isolation check: %s is writable\n" "$pinned" >&2
          exit 1
        fi
        if rm -f "$ISOLATED_RUN_DIR/$pinned" 2>/dev/null; then
          printf "isolation check: %s is deletable\n" "$pinned" >&2
          exit 1
        fi
      done
      relative="${ISOLATED_RUN_DIR#/home/ubuntu/articulated_script/runs/}"
      cursor=/home/ubuntu/articulated_script/runs
      IFS=/ read -r -a expected_parts <<< "$relative"
      for part in "${expected_parts[@]}"; do
        [[ "$(find "$cursor" -mindepth 1 -maxdepth 1 -printf "%f\n")" == "$part" ]]
        cursor="$cursor/$part"
      done
      [[ "$cursor" == "$ISOLATED_RUN_DIR" ]]
    else
      [[ -z "$(find /home/ubuntu/articulated_script/runs -mindepth 1 -print -quit)" ]]
    fi
    if [[ -n "${SANDBOX_EGRESS_CHECK:-}" ]]; then
      # These run before the tooling checks below, and deliberately so. The layer
      # this replaced failed silently -- Codex was asked to deny its commands the
      # network, did not, and nothing noticed for a whole run -- and a broken font
      # further down must not be what stops us from finding that out again.
      ! getent hosts github.com >/dev/null 2>&1
      # Any routable address will do; the assertion is that none of them connect.
      ! timeout 5 bash -c "exec 3<>/dev/tcp/140.82.121.4/443" 2>/dev/null
      ! timeout 5 bash -c "exec 3<>/dev/tcp/8.8.8.8/53" 2>/dev/null
      # The model provider, and only it, must still be reachable.
      check_host="${SANDBOX_EGRESS_CHECK%:*}"
      check_port="${SANDBOX_EGRESS_CHECK##*:}"
      [[ "$(getent hosts "$check_host" | awk "{ print \$1 }")" == 10.99.* ]]
      timeout 10 bash -c "exec 3<>/dev/tcp/$check_host/$check_port"
      # Nothing inside may widen its own reach.
      ! ip addr add 10.0.0.9/32 dev lo 2>/dev/null
      ! ip route add default via 10.99.1.1 2>/dev/null
      printf "isolation check: %s egress confined to %s\n" \
        "${ARTSCRIPT_CODEX_PROVIDER:-openai}" "$SANDBOX_EGRESS_CHECK"
    fi
    sleep 30 &
    child=$!
    kill "$child"
    wait "$child" 2>/dev/null || [[ "$?" -eq 143 ]]
    # Report which /proc the run got, because the two behave differently and the
    # difference is otherwise only visible as commands failing mid-run.
    if [[ -e /proc/1/root ]]; then
      ps -o pid= -p 1 >/dev/null
      [[ -r /proc/self/status ]]
      printf "isolation check: procfs belongs to this sandbox; ps works\n"
    else
      printf "isolation check: procfs is the stub; ps and psutil will not work\n" >&2
    fi
    micromamba run -n artscript python -c "import sys; assert sys.prefix == \"/opt/mamba/envs/artscript\""
    for tool in montage magick convert identify; do
      [[ "$(command -v "$tool")" == "/home/ubuntu/articulated_script/tools/bin/$tool" ]]
    done
    [[ "$(command -v rg)" == "/opt/codex/rg" ]]
    rg -q "Run Codex" /home/ubuntu/articulated_script/tools/codex-articulated
    montage -version | head -1
    font_test_dir="$(mktemp -d)"
    magick -size 16x16 xc:white "$font_test_dir/input.png"
    [[ "$(identify -format "%wx%h" "$font_test_dir/input.png")" == "16x16" ]]
    font_stderr="$(
      montage "$font_test_dir/input.png" -label test -tile 1x1 \
        -geometry +4+20 "$font_test_dir/output.png" 2>&1
    )"
    [[ "$font_stderr" != *"Fontconfig error"* ]]
    [[ -s "$font_test_dir/output.png" ]]
    [[ -d "${BLENDER_SYSTEM_RESOURCES:?BLENDER_SYSTEM_RESOURCES unset}/scripts" ]]
    /home/ubuntu/blender/blender --version | head -1
    # Exercise the resource walk that fails without BLENDER_SYSTEM_RESOURCES:
    # a background bpy import must succeed (not just --version).
    /home/ubuntu/blender/blender --background --factory-startup \
      --python-expr "import bpy" >/dev/null
    printf "isolation check: passed\n"
  '
  exit "$?"
fi

# The mount namespace is the filesystem boundary and the network namespace above
# is the egress boundary. Inside them Codex intentionally keeps unrestricted
# command execution without prompts.
#
# Codex's own --sandbox is deliberately not used as the network boundary, because
# it cannot be one here: its codex-linux-sandbox helper re-executes /proc/self/exe,
# which this launcher pins to micromamba for Blender, and when it cannot set
# itself up it fails open -- running commands unrestricted while reporting
# nothing. Enforcement belongs in the namespace above, where it cannot quietly
# degrade.
codex_argv=(
  /opt/codex/codex
  --dangerously-bypass-approvals-and-sandbox
  "$@"
)

if [[ "$SANDBOX_NET" == open ]]; then
  exec "${proc_prefix[@]}" bwrap "${bwrap_args[@]}" "${codex_argv[@]}"
fi

# Confined runs still exec, so stdin, stdout, stderr, the controlling terminal, the
# pid the supervisor recorded and its SIGHUP all behave exactly as they did before
# any of this existed. Cleanup is delegated to a detached copy of this script
# watching this pid, because an exec'd process cannot tear down what it became.
setsid "$(realpath "$0")" --egress-reap \
  "$EGRESS_NS" "$EGRESS_SLOT" "$$" "$EGRESS_GEN_DIR" "$EGRESS_STATE_DIR" \
  "$EGRESS_OWNER" "$EGRESS_BROKER_PID" "$EGRESS_STUB_PID" \
  </dev/null >/dev/null 2>&1 &

exec "${netns_prefix[@]}" "${proc_prefix[@]}" bwrap "${bwrap_args[@]}" "${codex_argv[@]}"
